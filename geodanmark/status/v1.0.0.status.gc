   <SimpleCodeList>
      <Row>
         <Value ColumnRef="kode">
            <SimpleValue>Projekt godkendt</SimpleValue>
         </Value>
         <Value ColumnRef="navn">
            <SimpleValue>Projekt godkendt</SimpleValue>
         </Value>
         <Value ColumnRef="definition">
            <SimpleValue>objekt er registreret i henhold til et godkendt projekt</SimpleValue>
         </Value>
         <Value ColumnRef="kommentar">
            <SimpleValue>objekter, der endnu ikke er etableret i virkeligheden, men kun er planlagt, indmeldes med denne værdi. Der må ikke udføres topologi eller konsekvensrettelser i forbindelse med data med denne objektstatus, da disse endnu ikke findes i virkeligheden</SimpleValue>
         </Value>
         <Value ColumnRef="virkningFra">
            <SimpleValue>2027-02-01</SimpleValue>
         </Value>
         <Value ColumnRef="virkningTil"/>
      </Row>
      <Row>
         <Value ColumnRef="kode">
            <SimpleValue>Under anlæg</SimpleValue>
         </Value>
         <Value ColumnRef="navn">
            <SimpleValue>Under anlæg</SimpleValue>
         </Value>
         <Value ColumnRef="definition">
            <SimpleValue>objektet er under anlæg</SimpleValue>
         </Value>
         <Value ColumnRef="kommentar">
            <SimpleValue>benyttes når projektet virkeliggøres og anlægsarbejdet er i gang</SimpleValue>
         </Value>
         <Value ColumnRef="virkningFra">
            <SimpleValue>2027-02-01</SimpleValue>
         </Value>
         <Value ColumnRef="virkningTil"/>
      </Row>
      <Row>
         <Value ColumnRef="kode">
            <SimpleValue>Anlagt</SimpleValue>
         </Value>
         <Value ColumnRef="navn">
            <SimpleValue>Anlagt</SimpleValue>
         </Value>
         <Value ColumnRef="definition">
            <SimpleValue>objektet findes i virkeligheden</SimpleValue>
         </Value>
         <Value ColumnRef="kommentar">
            <SimpleValue>dette er den normale situation for objekter, der eksisterer i virkeligheden</SimpleValue>
         </Value>
         <Value ColumnRef="virkningFra">
            <SimpleValue>2027-02-01</SimpleValue>
         </Value>
         <Value ColumnRef="virkningTil"/>
      </Row>
      <Row>
         <Value ColumnRef="kode">
            <SimpleValue>Under nedlæggelse</SimpleValue>
         </Value>
         <Value ColumnRef="navn">
            <SimpleValue>Under nedlæggelse</SimpleValue>
         </Value>
         <Value ColumnRef="definition">
            <SimpleValue>objektet er under nedlæggelse</SimpleValue>
         </Value>
         <Value ColumnRef="kommentar">
            <SimpleValue>hermed kan man angive, at funktionen er ophørt og at eksistensen snart ophører</SimpleValue>
         </Value>
         <Value ColumnRef="virkningFra">
            <SimpleValue>2027-02-01</SimpleValue>
         </Value>
         <Value ColumnRef="virkningTil"/>
      </Row>
   </SimpleCodeList>
