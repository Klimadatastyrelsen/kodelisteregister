   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/bygningstype/Bygning">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/bygningstype"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/bygningstype"/>
      <skos:notation>Bygning</skos:notation>
      <skos:prefLabel xml:lang="da">Bygning</skos:prefLabel>
      <skos:definition xml:lang="da">fast, overdækket konstruktion med tag, som er beregnet til ophold for mennesker eller dyr eller til opbevaring</skos:definition>
      <dcterms:valid>2027-02-01/..</dcterms:valid>
   </skos:Concept>
   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/bygningstype/Husbåd">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/bygningstype"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/bygningstype"/>
      <skos:notation>Husbåd</skos:notation>
      <skos:prefLabel xml:lang="da">Husbåd</skos:prefLabel>
      <skos:definition xml:lang="da">flydende konstruktion, der primært er indrettet til beboelse eller ophold, og som ligger fast fortøjet og ikke er beregnet til sejlads</skos:definition>
      <dcterms:valid>2027-02-01/..</dcterms:valid>
   </skos:Concept>
   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/bygningstype/Drivhus">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/bygningstype"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/bygningstype"/>
      <skos:notation>Drivhus</skos:notation>
      <skos:prefLabel xml:lang="da">Drivhus</skos:prefLabel>
      <skos:definition xml:lang="da">bygning med vægge og tag af overvejende lysgennemtrængeligt materiale, fx glas eller plast, som anvendes til dyrkning af planter</skos:definition>
      <dcterms:valid>2027-02-01/..</dcterms:valid>
   </skos:Concept>
   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/bygningstype/Tank/Silo">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/bygningstype"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/bygningstype"/>
      <skos:notation>Tank/Silo</skos:notation>
      <skos:prefLabel xml:lang="da">Tank/Silo</skos:prefLabel>
      <skos:definition xml:lang="da">lukket beholder til opbevaring af væsker, gasser eller løse materialer, fx olie, vand, korn eller foder</skos:definition>
      <dcterms:valid>2027-02-01/..</dcterms:valid>
   </skos:Concept>
   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/bygningstype/Andet">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/bygningstype"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/bygningstype"/>
      <skos:notation>Andet</skos:notation>
      <skos:prefLabel xml:lang="da">Andet</skos:prefLabel>
      <skos:definition xml:lang="da">værdi ikke omfattet af de øvrige mulige værdier</skos:definition>
      <rdfs:comment xml:lang="da">når en fagkyndig person kender den rette værdi, men den fremgår ikke blandt de lovlige værdier for attributten</rdfs:comment>
      <dcterms:valid>2027-02-01/..</dcterms:valid>
   </skos:Concept>
   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/bygningstype/Ikke tildelt">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/bygningstype"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/bygningstype"/>
      <skos:notation>Ikke tildelt</skos:notation>
      <skos:prefLabel xml:lang="da">Ikke tildelt</skos:prefLabel>
      <skos:definition xml:lang="da">tildelingen mangler</skos:definition>
      <rdfs:comment xml:lang="da">når der fagligt ikke er foretaget en vurdering af, hvilken værdi der er den rigtige</rdfs:comment>
      <dcterms:valid>2027-02-01/..</dcterms:valid>
   </skos:Concept>
</rdf:RDF>