   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/dagi/forretningshaendelse/SystemMigreringDagi3">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/dagi/forretningshaendelse"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/dagi/forretningshaendelse"/>
