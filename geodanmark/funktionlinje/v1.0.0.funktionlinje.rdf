   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/funktionlinje/Almindelig">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/funktionlinje"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/funktionlinje"/>
      <skos:notation>Almindelig</skos:notation>
      <skos:prefLabel xml:lang="da">Almindelig</skos:prefLabel>
      <skos:definition xml:lang="da">anden form for forhindring end kontraklap og sluse</skos:definition>
      <dcterms:valid>2027-02-01/..</dcterms:valid>
   </skos:Concept>
   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/funktionlinje/Kontraklap">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/funktionlinje"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/funktionlinje"/>
      <skos:notation>Kontraklap</skos:notation>
      <skos:prefLabel xml:lang="da">Kontraklap</skos:prefLabel>
      <skos:definition xml:lang="da">en selvvirkende klap i et gennemløb eller udløb, som lader vandet løbe ud, men lukker af sig selv, når vandstanden på den anden side bliver højere, så vandet ikke kan løbe tilbage</skos:definition>
      <dcterms:valid>2027-02-01/..</dcterms:valid>
   </skos:Concept>
   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/funktionlinje/Sluse">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/funktionlinje"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/funktionlinje"/>
      <skos:notation>Sluse</skos:notation>
      <skos:prefLabel xml:lang="da">Sluse</skos:prefLabel>
      <skos:definition xml:lang="da">bygværk med porte eller skodder, der kan åbnes og lukkes og derved regulere vandets løb gennem en dæmning, et dige eller et vandløb, fx en højvandssluse.</skos:definition>
      <dcterms:valid>2027-02-01/..</dcterms:valid>
   </skos:Concept>
   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/funktionlinje/Pumpe">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/funktionlinje"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/funktionlinje"/>
      <skos:notation>Pumpe</skos:notation>
      <skos:prefLabel xml:lang="da">Pumpe</skos:prefLabel>
      <skos:definition xml:lang="da">tilpasning som aktivt løfter eller fører overfladevand gennem en forhindring, fx et dige eller en dæmning.</skos:definition>
      <rdfs:comment xml:lang="da">vandet løber kun i én retning, fra objektets startpunkt mod dets slutpunkt, dvs. i digitaliseringsretningen</rdfs:comment>
      <dcterms:valid>2027-02-01/..</dcterms:valid>
   </skos:Concept>
</rdf:RDF>