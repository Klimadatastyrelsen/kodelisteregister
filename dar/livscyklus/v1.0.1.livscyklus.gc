      <Agency>
         <LongName>Klimadatastyrelsen</LongName>
      </Agency>
   </Identification>
   <ColumnSet>
      <Column Id="kode"
              Use="required">
         <Annotation>
            <Description>
               <dcterms:description>tilladt værdi i data</dcterms:description>
            </Description>
         </Annotation>
         <ShortName>kode</ShortName>
         <Data Type="string"/>
      </Column>
      <Column Id="navn"
              Use="required">
         <Annotation>
            <Description>
               <dcterms:description>foretrukne term for koden</dcterms:description>
            </Description>
         </Annotation>
         <ShortName>navn</ShortName>
         <Data Type="string"
               Lang="da"/>
      </Column>
      <Column Id="definition"
              Use="optional">
         <Annotation>
            <Description>
               <dcterms:description>kort beskrivelse eller formel forklaring af kodens betydning</dcterms:description>
            </Description>
         </Annotation>
         <ShortName>definition</ShortName>
         <Data Type="string"
               Lang="da"/>
      </Column>
      <Column Id="kommentar"
              Use="optional">
         <Annotation>
            <Description>
               <dcterms:description>kommentar som hjælper til afklaring af forståelse af koden</dcterms:description>
            </Description>
         </Annotation>
         <ShortName>kommentar</ShortName>
         <Data Type="string"
               Lang="da"/>
      </Column>
      <Column Id="virkningFra"
              Use="required">
         <Annotation>
            <Description>
               <dcterms:description>tidspunkt for hvornår koden må tages i anvendelse for nye registreringer</dcterms:description>
            </Description>
         </Annotation>
         <ShortName>virkningFra</ShortName>
         <Data Type="date"/>
      </Column>
      <Column Id="virkningTil"
              Use="optional">
         <Annotation>
            <Description>
               <dcterms:description>tidspunkt for hvornår koden ikke længere må anvendes i nye registreringer. Koden kan eksistere i data, der er registreret før dette tidspunkt</dcterms:description>
            </Description>
         </Annotation>
         <ShortName>virkningTil</ShortName>
         <Data Type="date"/>
      </Column>
      <Key Id="key_code">
         <ShortName>key_code</ShortName>
         <ColumnRef Ref="kode"/>
      </Key>
      <Key Id="key_navn">
         <ShortName>key_navn</ShortName>
         <ColumnRef Ref="navn"/>
      </Key>
   </ColumnSet>
   <SimpleCodeList>
      <Row>
         <Value ColumnRef="kode">
            <SimpleValue>1</SimpleValue>
         </Value>
         <Value ColumnRef="navn">
            <SimpleValue>Intern forberedelse</SimpleValue>
         </Value>
         <Value ColumnRef="definition">
            <SimpleValue>objektet bruges i arbejdsskitse til internt brug i kommunen</SimpleValue>
         </Value>
         <Value ColumnRef="kommentar">
            <SimpleValue>Anvendes til at udarbejde en arbejdsskitse til internt brug i kommunen, som ikke skal udstilles. Kan bruges for entiteterne adresse, husnummer og navngivenvej. OBS udstilles ikke.</SimpleValue>
         </Value>
         <Value ColumnRef="virkningFra">
            <SimpleValue>2015-10-01</SimpleValue>
         </Value>
         <Value ColumnRef="virkningTil"/>
      </Row>
      <Row>
         <Value ColumnRef="kode">
            <SimpleValue>2</SimpleValue>
         </Value>
         <Value ColumnRef="navn">
            <SimpleValue>Foreløbig</SimpleValue>
         </Value>
         <Value ColumnRef="definition">
            <SimpleValue>objektet er foreløbigt og ikke udstillet</SimpleValue>
         </Value>
         <Value ColumnRef="kommentar">
            <SimpleValue>Anvendes for entiteter, inden de bliver gjort gældende. Udstilles til anvendere og kan anvendes af fx BBR til at danne relationen mellem bygning og husnummer. Kan bruges for entiteterne adresse, husnummer og navngivenvej.</SimpleValue>
         </Value>
         <Value ColumnRef="virkningFra">
            <SimpleValue>2015-10-01</SimpleValue>
         </Value>
         <Value ColumnRef="virkningTil"/>
      </Row>
      <Row>
         <Value ColumnRef="kode">
            <SimpleValue>3</SimpleValue>
         </Value>
         <Value ColumnRef="navn">
            <SimpleValue>Gældende</SimpleValue>
         </Value>
         <Value ColumnRef="definition">
            <SimpleValue>objektet er gældende</SimpleValue>
         </Value>
         <Value ColumnRef="kommentar">
            <SimpleValue>Kan bruges for entiteterne DAR_Adresse, DAR_Husnummer, DAR_navngivenVej, DAR_NavngivenVejKommunedel, DAR_NavngivenVejPostnummer, DAR_NavngivenvejSupplerendeBynavn og DAR_SupplerendeBynavn.</SimpleValue>
         </Value>
         <Value ColumnRef="virkningFra">
            <SimpleValue>2015-10-01</SimpleValue>
         </Value>
         <Value ColumnRef="virkningTil"/>
      </Row>
      <Row>
         <Value ColumnRef="kode">
            <SimpleValue>4</SimpleValue>
         </Value>
         <Value ColumnRef="navn">
            <SimpleValue>Nedlagt</SimpleValue>
         </Value>
         <Value ColumnRef="definition">
            <SimpleValue>objektet er nedlagt</SimpleValue>
         </Value>
         <Value ColumnRef="kommentar">
            <SimpleValue>Entiteter som tidligere har haft status gældende, får denne status når de nedlægges. Kan bruges for entiteterne DAR_Adresse, DAR_Husnummer, DAR_navngivenVej, DAR_NavngivenVejKommunedel, DAR_NavngivenVejPostnummer, DAR_NavngivenvejSupplerendeBynavn og DAR_SupplerendeBynavn.</SimpleValue>
         </Value>
         <Value ColumnRef="virkningFra">
            <SimpleValue>2015-10-01</SimpleValue>
         </Value>
         <Value ColumnRef="virkningTil"/>
      </Row>
      <Row>
         <Value ColumnRef="kode">
            <SimpleValue>5</SimpleValue>
         </Value>
         <Value ColumnRef="navn">
            <SimpleValue>Henlagt</SimpleValue>
         </Value>
         <Value ColumnRef="definition">
            <SimpleValue>objektet er henlagt</SimpleValue>
         </Value>
         <Value ColumnRef="kommentar">
            <SimpleValue>Anvendes kun til entiteter hvis foregående status har været ”foreløbig”. Kan bruges for entiteterne adresse, husnummer og navngivenvej.</SimpleValue>
         </Value>
         <Value ColumnRef="virkningFra">
            <SimpleValue>2015-10-01</SimpleValue>
         </Value>
         <Value ColumnRef="virkningTil"/>
      </Row>
      <Row>
         <Value ColumnRef="kode">
            <SimpleValue>6</SimpleValue>
         </Value>
         <Value ColumnRef="navn">
            <SimpleValue>Slettet</SimpleValue>
         </Value>
         <Value ColumnRef="definition">
            <SimpleValue>objektet er slettet</SimpleValue>
         </Value>
         <Value ColumnRef="kommentar">
            <SimpleValue>For entiteterne adresse, husnummer og navngivenvej: Anvendes kun til entiteter hvis foregående status har været ”intern forberedelse". For entiteterne adgang- og vejpunkt: Anvendes hvis den foregående status har været ”Ikke i brug”, udstilles kun i fildownload.</SimpleValue>
         </Value>
         <Value ColumnRef="virkningFra">
            <SimpleValue>2015-10-01</SimpleValue>
         </Value>
         <Value ColumnRef="virkningTil"/>
      </Row>
      <Row>
         <Value ColumnRef="kode">
            <SimpleValue>7</SimpleValue>
         </Value>
         <Value ColumnRef="navn">
            <SimpleValue>Ikke i brug</SimpleValue>
         </Value>
         <Value ColumnRef="definition">
            <SimpleValue>objektet er ikke i brug</SimpleValue>
         </Value>
         <Value ColumnRef="kommentar">
            <SimpleValue>Anvendes når der ikke er tilknyttet adresser til adgangspunktet, og udstilles kun til særlige anvendelser. Kan bruges for entiteterne adgang- og vejpunkt.</SimpleValue>
         </Value>
         <Value ColumnRef="virkningFra">
            <SimpleValue>2015-10-01</SimpleValue>
         </Value>
         <Value ColumnRef="virkningTil"/>
      </Row>
      <Row>
         <Value ColumnRef="kode">
            <SimpleValue>8</SimpleValue>
         </Value>
         <Value ColumnRef="navn">
            <SimpleValue>I brug</SimpleValue>
         </Value>
         <Value ColumnRef="definition">
            <SimpleValue>objektet er i brug</SimpleValue>
         </Value>
         <Value ColumnRef="kommentar">
            <SimpleValue>Objektet er i brug. Kan bruges for entiteterne adgang- og vejpunkt.</SimpleValue>
         </Value>
         <Value ColumnRef="virkningFra">
            <SimpleValue>2015-10-01</SimpleValue>
         </Value>
         <Value ColumnRef="virkningTil"/>
      </Row>
      <Row>
         <Value ColumnRef="kode">
            <SimpleValue>9</SimpleValue>
         </Value>
         <Value ColumnRef="navn">
            <SimpleValue>Udgået</SimpleValue>
         </Value>
         <Value ColumnRef="definition">
            <SimpleValue>objektet er udgået</SimpleValue>
         </Value>
         <Value ColumnRef="kommentar">
            <SimpleValue>Anvendes hvis den foregående status har været ”I brug”, og hvor Husnummer har status ”henlagt” eller ”nedlagt”. Kan bruges for entiteterne adgang- og vejpunkt. Udstilles kun i fildownload.</SimpleValue>
         </Value>
         <Value ColumnRef="virkningFra">
            <SimpleValue>2015-10-01</SimpleValue>
         </Value>
         <Value ColumnRef="virkningTil"/>
      </Row>
      <Row>
         <Value ColumnRef="kode">
            <SimpleValue>10</SimpleValue>
         </Value>
         <Value ColumnRef="navn">
            <SimpleValue>Udløbet</SimpleValue>
         </Value>
         <Value ColumnRef="definition">
            <SimpleValue>objektet er udløbet</SimpleValue>
         </Value>
         <Value ColumnRef="kommentar">
            <SimpleValue>Anvendes til reserverede vejnavne, hvis reservation er bortfaldet, uden at vejnavnet er blevet taget i brug. Bruges kun ved reserverede vejnavne, der ikke udstilles direkte fra DAR.</SimpleValue>
         </Value>
         <Value ColumnRef="virkningFra">
            <SimpleValue>2015-10-01</SimpleValue>
         </Value>
         <Value ColumnRef="virkningTil"/>
      </Row>
      <Row>
         <Value ColumnRef="kode">
            <SimpleValue>11</SimpleValue>
         </Value>
         <Value ColumnRef="navn">
            <SimpleValue>Ophævet</SimpleValue>
         </Value>
         <Value ColumnRef="definition">
            <SimpleValue>objektet er ophævet</SimpleValue>
         </Value>
         <Value ColumnRef="kommentar">
            <SimpleValue>Anvendes til reserverede vejnavne, hvis reservation er bortfaldet, uden at vejnavnet er blevet taget i brug. Bruges kun ved reserverede vejnavne, der ikke udstilles direkte fra DAR.</SimpleValue>
         </Value>
         <Value ColumnRef="virkningFra">
            <SimpleValue>2015-10-01</SimpleValue>
         </Value>
         <Value ColumnRef="virkningTil"/>
      </Row>
   </SimpleCodeList>
</gc:CodeList>