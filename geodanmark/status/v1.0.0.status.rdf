   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/status/Projekt godkendt">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/status"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/status"/>
      <skos:notation>Projekt godkendt</skos:notation>
      <skos:prefLabel xml:lang="da">Projekt godkendt</skos:prefLabel>
      <skos:definition xml:lang="da">objekt er registreret i henhold til et godkendt projekt</skos:definition>
      <rdfs:comment xml:lang="da">objekter, der endnu ikke er etableret i virkeligheden, men kun er planlagt, indmeldes med denne værdi. Der må ikke udføres topologi eller konsekvensrettelser i forbindelse med data med denne objektstatus, da disse endnu ikke findes i virkeligheden</rdfs:comment>
      <dcterms:valid>2027-02-01/..</dcterms:valid>
   </skos:Concept>
   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/status/Under anlæg">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/status"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/status"/>
      <skos:notation>Under anlæg</skos:notation>
      <skos:prefLabel xml:lang="da">Under anlæg</skos:prefLabel>
      <skos:definition xml:lang="da">objektet er under anlæg</skos:definition>
      <rdfs:comment xml:lang="da">benyttes når projektet virkeliggøres og anlægsarbejdet er i gang</rdfs:comment>
      <dcterms:valid>2027-02-01/..</dcterms:valid>
   </skos:Concept>
   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/status/Anlagt">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/status"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/status"/>
      <skos:notation>Anlagt</skos:notation>
      <skos:prefLabel xml:lang="da">Anlagt</skos:prefLabel>
      <skos:definition xml:lang="da">objektet findes i virkeligheden</skos:definition>
      <rdfs:comment xml:lang="da">dette er den normale situation for objekter, der eksisterer i virkeligheden</rdfs:comment>
      <dcterms:valid>2027-02-01/..</dcterms:valid>
   </skos:Concept>
   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/status/Under nedlæggelse">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/status"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/status"/>
      <skos:notation>Under nedlæggelse</skos:notation>
      <skos:prefLabel xml:lang="da">Under nedlæggelse</skos:prefLabel>
      <skos:definition xml:lang="da">objektet er under nedlæggelse</skos:definition>
      <rdfs:comment xml:lang="da">hermed kan man angive, at funktionen er ophørt og at eksistensen snart ophører</rdfs:comment>
      <dcterms:valid>2027-02-01/..</dcterms:valid>
   </skos:Concept>
</rdf:RDF>