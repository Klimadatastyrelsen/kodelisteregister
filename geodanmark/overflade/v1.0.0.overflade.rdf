   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/overflade/Befæstet">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/overflade"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/overflade"/>
      <skos:notation>Befæstet</skos:notation>
      <skos:prefLabel xml:lang="da">Befæstet</skos:prefLabel>
      <skos:definition xml:lang="da">befæstet dvs. overfladen er belagt med et hårdt materiale i form af asfalt, beton, brosten, fliser eller lignende</skos:definition>
      <dcterms:valid>2027-02-01/..</dcterms:valid>
   </skos:Concept>
   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/overflade/Ubefæstet">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/overflade"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/overflade"/>
      <skos:notation>Ubefæstet</skos:notation>
      <skos:prefLabel xml:lang="da">Ubefæstet</skos:prefLabel>
      <skos:definition xml:lang="da">ubefæstet dvs. overfladen er grus, sand, jord eller lignende</skos:definition>
      <dcterms:valid>2027-02-01/..</dcterms:valid>
   </skos:Concept>
