   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/dar/tekniskstandard/Adgangspunkt uspecificeret eller foreløbigt placeret">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/dar/tekniskstandard"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/dar/tekniskstandard"/>
      <skos:notation>UF</skos:notation>
      <skos:prefLabel xml:lang="da">Adgangspunkt uspecificeret eller foreløbigt placeret</skos:prefLabel>
      <skos:definition xml:lang="da">den tekniske standard bruges ved adgangspunkter hvor placeringen er uspecificeret eller foreløbigt placeret, f.eks. ved nybyggeri inden der er tilknyttet bygning</skos:definition>
      <dcterms:valid>2015-10-01/..</dcterms:valid>
   </skos:Concept>
   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/dar/tekniskstandard/Adgangspunkt inden for bygningsomrids">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/dar/tekniskstandard"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/dar/tekniskstandard"/>
      <skos:notation>TN</skos:notation>
      <skos:prefLabel xml:lang="da">Adgangspunkt inden for bygningsomrids</skos:prefLabel>
      <skos:definition xml:lang="da">anvendes når adgangspunktet er placeret ca. 3 meter inden i bygningen inden for bygningens omrids</skos:definition>
      <dcterms:valid>2015-10-01/..</dcterms:valid>
   </skos:Concept>
   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/dar/tekniskstandard/Adgangspunkt ved bygningsfacade mod vej">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/dar/tekniskstandard"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/dar/tekniskstandard"/>
      <skos:notation>TK</skos:notation>
      <skos:prefLabel xml:lang="da">Adgangspunkt ved bygningsfacade mod vej</skos:prefLabel>
      <skos:definition xml:lang="da">anvendes når adgangspunktet er placeret ca. 3 meter inden i bygningen langs facaden mod adgangsvejen</skos:definition>
      <dcterms:valid>2015-10-01/..</dcterms:valid>
   </skos:Concept>
   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/dar/tekniskstandard/Adgangspunkt ved indgangsdør til bygning">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/dar/tekniskstandard"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/dar/tekniskstandard"/>
      <skos:notation>TD</skos:notation>
      <skos:prefLabel xml:lang="da">Adgangspunkt ved indgangsdør til bygning</skos:prefLabel>
      <skos:definition xml:lang="da">anvendes når adgangspunktet er placeret ca. 3 meter inden i bygningen ved indgangsdøren</skos:definition>
      <dcterms:valid>2015-10-01/..</dcterms:valid>
   </skos:Concept>
   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/dar/tekniskstandard/Adgangspunkt til anlæg – uden bygning">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/dar/tekniskstandard"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/dar/tekniskstandard"/>
      <skos:notation>TA</skos:notation>
      <skos:prefLabel xml:lang="da">Adgangspunkt til anlæg – uden bygning</skos:prefLabel>
      <skos:definition xml:lang="da">adresser, hvor adgangspunktet ikke er eller skal være tilknyttet en bygning - og husbåde samt indkørsler og ramper til parkeringsanlæg</skos:definition>
      <dcterms:valid>2015-10-01/..</dcterms:valid>
   </skos:Concept>
   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/dar/tekniskstandard/Vejpunkt er uspecificeret eller ukendt">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/dar/tekniskstandard"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/dar/tekniskstandard"/>
      <skos:notation>VU</skos:notation>
      <skos:prefLabel xml:lang="da">Vejpunkt er uspecificeret eller ukendt</skos:prefLabel>
      <skos:definition xml:lang="da">vejpunkt er uspecificeret eller ukendt</skos:definition>
      <dcterms:valid>2015-10-01/..</dcterms:valid>
   </skos:Concept>
