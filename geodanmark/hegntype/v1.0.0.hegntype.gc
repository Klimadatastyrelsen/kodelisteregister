   <SimpleCodeList>
      <Row>
         <Value ColumnRef="kode">
            <SimpleValue>Levende</SimpleValue>
         </Value>
         <Value ColumnRef="navn">
            <SimpleValue>Levende</SimpleValue>
         </Value>
         <Value ColumnRef="definition">
            <SimpleValue>alle former for afgrænsninger med en vis fysisk forhindring i form af levende vækster. Hæk, buske , tætstående træer på række, læbælte og lignende</SimpleValue>
         </Value>
         <Value ColumnRef="kommentar"/>
