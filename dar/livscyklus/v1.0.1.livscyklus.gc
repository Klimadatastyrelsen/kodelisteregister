<?xml version="1.0" encoding="UTF-8"?>
<gc:CodeList xmlns:gc="http://docs.oasis-open.org/codelist/ns/genericode/1.0/"
             xmlns:dcterms="http://purl.org/dc/terms/">
   <Annotation>
      <Description>
         <dcterms:description>Kodelisten indeholder mulige værdier for livscyklus til DAR.</dcterms:description>
         <dcterms:provenance>Kodelisten er opdateret med definitioner og evt. kommentarer.</dcterms:provenance>
