   <SimpleCodeList>
      <Row>
         <Value ColumnRef="kode">
            <SimpleValue>Høfde</SimpleValue>
         </Value>
         <Value ColumnRef="navn">
            <SimpleValue>Høfde</SimpleValue>
         </Value>
         <Value ColumnRef="definition">
            <SimpleValue>en langstrakt, smal konstruktion bygget vinkelret ud fra stranden og ud i vandet for at beskytte kysten mod bølgeerosion og sandvandring</SimpleValue>
         </Value>
         <Value ColumnRef="kommentar">
            <SimpleValue>høfde er anlagt vinkelret ud fra Kyst</SimpleValue>
         </Value>
         <Value ColumnRef="virkningFra">
            <SimpleValue>2027-02-01</SimpleValue>
         </Value>
         <Value ColumnRef="virkningTil"/>
      </Row>
      <Row>
         <Value ColumnRef="kode">
            <SimpleValue>Bølgebryder</SimpleValue>
         </Value>
         <Value ColumnRef="navn">
            <SimpleValue>Bølgebryder</SimpleValue>
         </Value>
         <Value ColumnRef="definition">
            <SimpleValue>konstruktion i vandet – typisk bygget af sten eller beton – som har til formål at dæmpe bølgeslag og skabe roligt vand bag sig</SimpleValue>
         </Value>
         <Value ColumnRef="kommentar">
            <SimpleValue>bølgebryder er anlagt parallelt med Kyst</SimpleValue>
         </Value>
         <Value ColumnRef="virkningFra">
            <SimpleValue>2027-02-01</SimpleValue>
         </Value>
         <Value ColumnRef="virkningTil"/>
      </Row>
      <Row>
         <Value ColumnRef="kode">
            <SimpleValue>Slikgård</SimpleValue>
         </Value>
         <Value ColumnRef="navn">
            <SimpleValue>Slikgård</SimpleValue>
         </Value>
         <Value ColumnRef="definition">
            <SimpleValue>indhegnet område på tidevandskyst, der bruges til landvinding</SimpleValue>
         </Value>
         <Value ColumnRef="kommentar"/>
         <Value ColumnRef="virkningFra">
            <SimpleValue>2027-02-01</SimpleValue>
         </Value>
         <Value ColumnRef="virkningTil"/>
      </Row>
      <Row>
         <Value ColumnRef="kode">
            <SimpleValue>Andet</SimpleValue>
         </Value>
         <Value ColumnRef="navn">
            <SimpleValue>Andet</SimpleValue>
         </Value>
         <Value ColumnRef="definition">
            <SimpleValue>kystbeskyttelseskonstruktion, som ikke kan identificeres som én af de overstående kategorier</SimpleValue>
         </Value>
         <Value ColumnRef="kommentar"/>
         <Value ColumnRef="virkningFra">
            <SimpleValue>2027-02-01</SimpleValue>
         </Value>
         <Value ColumnRef="virkningTil"/>
      </Row>
   </SimpleCodeList>
