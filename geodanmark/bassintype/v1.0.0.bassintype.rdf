   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/bassintype/Rensningsanlæg">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/bassintype"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/bassintype"/>
      <skos:notation>Rensningsanlæg</skos:notation>
      <skos:prefLabel xml:lang="da">Rensningsanlæg</skos:prefLabel>
      <skos:definition xml:lang="da">anlæg til rensning af spildevand</skos:definition>
      <rdfs:comment xml:lang="da">rodzoneanlæg og minivådområde registreres som "Rensningsanlæg"</rdfs:comment>
      <dcterms:valid>2027-02-01/..</dcterms:valid>
   </skos:Concept>
   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/bassintype/Svømmebassin">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/bassintype"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/bassintype"/>
      <skos:notation>Svømmebassin</skos:notation>
      <skos:prefLabel xml:lang="da">Svømmebassin</skos:prefLabel>
      <skos:definition xml:lang="da">bassin fyldt med vand, der er beregnet til at svømme og bade i</skos:definition>
      <rdfs:comment xml:lang="da">frilufts-/svømmebassin</rdfs:comment>
      <dcterms:valid>2027-02-01/..</dcterms:valid>
   </skos:Concept>
   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/bassintype/Ikke tildelt">
