   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/bygvaerktype/Tunnel">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/bygvaerktype"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/bygvaerktype"/>
      <skos:notation>Tunnel</skos:notation>
      <skos:prefLabel xml:lang="da">Tunnel</skos:prefLabel>
      <skos:definition xml:lang="da">underføring under land, under hav- eller søbund og/eller vand. En tunnel muliggør en passage under terræn for kørende eller gående trafik eller for dyr. Tunnel har et indgangsparti i begge ender</skos:definition>
      <dcterms:valid>2027-02-01/..</dcterms:valid>
   </skos:Concept>
   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/bygvaerktype/Bro">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/bygvaerktype"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/bygvaerktype"/>
      <skos:notation>Bro</skos:notation>
      <skos:prefLabel xml:lang="da">Bro</skos:prefLabel>
      <skos:definition xml:lang="da">en overføring over land og/eller vand. Overføringen består af et brodække af f.eks. beton. Brodækket er selvbærende eller bæres af piller og/eller er ophængt i kabler</skos:definition>
      <dcterms:valid>2027-02-01/..</dcterms:valid>
   </skos:Concept>
   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/bygvaerktype/Spang">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/bygvaerktype"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/bygvaerktype"/>
      <skos:notation>Spang</skos:notation>
      <skos:prefLabel xml:lang="da">Spang</skos:prefLabel>
      <skos:definition xml:lang="da">simpel og smal overføring over et mindre vandløb eller anden lavning i terrænet f.eks. en grøft. Kun gående og tohjulet trafik kan passere.</skos:definition>
      <rdfs:comment xml:lang="da">smalle ”Spang” med en bredde &lt; 2 meter registreres som en enkelt linje ved skønnet midte. Brede ”Spang” med en bredde =&gt; 2 registreres ved kanten hele vejen rundt om spangen og dets ender snappes sammen</rdfs:comment>
      <dcterms:valid>2027-02-01/..</dcterms:valid>
   </skos:Concept>
   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/bygvaerktype/Højvandsmur">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/bygvaerktype"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/bygvaerktype"/>
      <skos:notation>Højvandsmur</skos:notation>
      <skos:prefLabel xml:lang="da">Højvandsmur</skos:prefLabel>
      <skos:definition xml:lang="da">konstruktion bestående af betonvæg, stålspuns, plastspuns eller træspuns anlagt primært ved kyst i havneområder og byer, hvor højvandsmuren beskytter baglandet mod oversvømmelse fra hav ved højvande</skos:definition>
      <dcterms:valid>2027-02-01/..</dcterms:valid>
   </skos:Concept>
</rdf:RDF>