   <SimpleCodeList>
      <Row>
         <Value ColumnRef="kode">
            <SimpleValue>Motorkøretøj</SimpleValue>
         </Value>
         <Value ColumnRef="navn">
            <SimpleValue>Motorkøretøj</SimpleValue>
         </Value>
         <Value ColumnRef="definition">
            <SimpleValue>kun færdsel af køretøj, der hovedsageligt er indrettet til selvstændigt at benyttes til person- eller godstransport. Minimumshastigheden er 45 km/t</SimpleValue>
         </Value>
         <Value ColumnRef="kommentar"/>
         <Value ColumnRef="virkningFra">
            <SimpleValue>2027-02-01</SimpleValue>
         </Value>
         <Value ColumnRef="virkningTil"/>
      </Row>
      <Row>
         <Value ColumnRef="kode">
            <SimpleValue>Al færdsel</SimpleValue>
         </Value>
         <Value ColumnRef="navn">
            <SimpleValue>Al færdsel</SimpleValue>
         </Value>
         <Value ColumnRef="definition">
            <SimpleValue>her foregår alle former for trafik</SimpleValue>
         </Value>
         <Value ColumnRef="kommentar"/>
         <Value ColumnRef="virkningFra">
            <SimpleValue>2027-02-01</SimpleValue>
         </Value>
         <Value ColumnRef="virkningTil"/>
      </Row>
      <Row>
         <Value ColumnRef="kode">
            <SimpleValue>2 minus 1 vej</SimpleValue>
         </Value>
         <Value ColumnRef="navn">
            <SimpleValue>2 minus 1 vej</SimpleValue>
         </Value>
         <Value ColumnRef="definition">
            <SimpleValue>en vej med kun et spor for bilister. Kørebanen er på begge sider afmærket med brede, stiplede malede kanter. Området i midten er beregnet for biler, mens områderne i siderne er beregnet for cykler. Biler må dog godt parkere og køre ind over for kantbemalingen</SimpleValue>
         </Value>
         <Value ColumnRef="kommentar">
            <SimpleValue>der registreres kun én linje i midten af den samlede vejbredde. Der registreres ikke en Vejmidte i cykelområderne. Ajourføres administrativt</SimpleValue>
         </Value>
         <Value ColumnRef="virkningFra">
            <SimpleValue>2027-02-01</SimpleValue>
         </Value>
         <Value ColumnRef="virkningTil"/>
      </Row>
      <Row>
         <Value ColumnRef="kode">
            <SimpleValue>Sideanlæg</SimpleValue>
         </Value>
         <Value ColumnRef="navn">
            <SimpleValue>Sideanlæg</SimpleValue>
         </Value>
         <Value ColumnRef="definition">
            <SimpleValue>anlæg ved vejen er faciliteter, som rastepladser, tankstationer og serviceanlæg</SimpleValue>
         </Value>
         <Value ColumnRef="kommentar"/>
         <Value ColumnRef="virkningFra">
            <SimpleValue>2027-02-01</SimpleValue>
         </Value>
         <Value ColumnRef="virkningTil"/>
      </Row>
      <Row>
         <Value ColumnRef="kode">
            <SimpleValue>Gågade</SimpleValue>
         </Value>
         <Value ColumnRef="navn">
            <SimpleValue>Gågade</SimpleValue>
         </Value>
         <Value ColumnRef="definition">
            <SimpleValue>trafikken er en gående</SimpleValue>
         </Value>
         <Value ColumnRef="kommentar">
            <SimpleValue>bruges kun, når vejen er skiltet som gågade. Det er typisk gader i bymidter, som har vejnavn og adresser</SimpleValue>
         </Value>
         <Value ColumnRef="virkningFra">
            <SimpleValue>2027-02-01</SimpleValue>
         </Value>
         <Value ColumnRef="virkningTil"/>
      </Row>
      <Row>
         <Value ColumnRef="kode">
            <SimpleValue>Cykelgade</SimpleValue>
         </Value>
         <Value ColumnRef="navn">
            <SimpleValue>Cykelgade</SimpleValue>
         </Value>
         <Value ColumnRef="definition">
            <SimpleValue>trafikken er en cyklende</SimpleValue>
         </Value>
         <Value ColumnRef="kommentar">
            <SimpleValue>bruges kun, når vejen er skiltet som cykelgade</SimpleValue>
         </Value>
         <Value ColumnRef="virkningFra">
            <SimpleValue>2027-02-01</SimpleValue>
         </Value>
         <Value ColumnRef="virkningTil"/>
      </Row>
      <Row>
         <Value ColumnRef="kode">
            <SimpleValue>Cykel- og gangsti</SimpleValue>
         </Value>
         <Value ColumnRef="navn">
            <SimpleValue>Cykel- og gangsti</SimpleValue>
         </Value>
         <Value ColumnRef="definition">
            <SimpleValue>trafikken er både gående og cyklende færdsel</SimpleValue>
         </Value>
         <Value ColumnRef="kommentar"/>
         <Value ColumnRef="virkningFra">
            <SimpleValue>2027-02-01</SimpleValue>
         </Value>
         <Value ColumnRef="virkningTil"/>
      </Row>
      <Row>
         <Value ColumnRef="kode">
            <SimpleValue>Gangsti</SimpleValue>
         </Value>
         <Value ColumnRef="navn">
            <SimpleValue>Gangsti</SimpleValue>
         </Value>
         <Value ColumnRef="definition">
            <SimpleValue>trafikken er kun for gående færdsel</SimpleValue>
         </Value>
         <Value ColumnRef="kommentar">
            <SimpleValue>bruges, når stien alene er beregnet for gående</SimpleValue>
         </Value>
         <Value ColumnRef="virkningFra">
            <SimpleValue>2027-02-01</SimpleValue>
         </Value>
         <Value ColumnRef="virkningTil"/>
      </Row>
      <Row>
         <Value ColumnRef="kode">
            <SimpleValue>Cykelsti</SimpleValue>
         </Value>
         <Value ColumnRef="navn">
            <SimpleValue>Cykelsti</SimpleValue>
         </Value>
         <Value ColumnRef="definition">
            <SimpleValue>trafikken er kun for cyklende færdsel</SimpleValue>
         </Value>
         <Value ColumnRef="kommentar">
            <SimpleValue>cykelstier langs vej og cykelstier i eget tracé</SimpleValue>
         </Value>
         <Value ColumnRef="virkningFra">
            <SimpleValue>2027-02-01</SimpleValue>
         </Value>
         <Value ColumnRef="virkningTil"/>
      </Row>
      <Row>
         <Value ColumnRef="kode">
            <SimpleValue>Redningsvej</SimpleValue>
         </Value>
         <Value ColumnRef="navn">
            <SimpleValue>Redningsvej</SimpleValue>
         </Value>
         <Value ColumnRef="definition">
            <SimpleValue>trafikken er kun for redningskørsel</SimpleValue>
         </Value>
