   <SimpleCodeList>
      <Row>
         <Value ColumnRef="kode">
            <SimpleValue>Almindelig</SimpleValue>
         </Value>
         <Value ColumnRef="navn">
            <SimpleValue>Almindelig</SimpleValue>
         </Value>
         <Value ColumnRef="definition">
            <SimpleValue>anden form for forhindring end kontraklap og sluse</SimpleValue>
         </Value>
         <Value ColumnRef="kommentar"/>
         <Value ColumnRef="virkningFra">
            <SimpleValue>2027-02-01</SimpleValue>
         </Value>
         <Value ColumnRef="virkningTil"/>
      </Row>
      <Row>
         <Value ColumnRef="kode">
            <SimpleValue>Kontraklap</SimpleValue>
         </Value>
         <Value ColumnRef="navn">
            <SimpleValue>Kontraklap</SimpleValue>
         </Value>
         <Value ColumnRef="definition">
            <SimpleValue>en selvvirkende klap i et gennemløb eller udløb, som lader vandet løbe ud, men lukker af sig selv, når vandstanden på den anden side bliver højere, så vandet ikke kan løbe tilbage</SimpleValue>
         </Value>
         <Value ColumnRef="kommentar"/>
         <Value ColumnRef="virkningFra">
            <SimpleValue>2027-02-01</SimpleValue>
         </Value>
         <Value ColumnRef="virkningTil"/>
      </Row>
      <Row>
         <Value ColumnRef="kode">
            <SimpleValue>Sluse</SimpleValue>
         </Value>
         <Value ColumnRef="navn">
            <SimpleValue>Sluse</SimpleValue>
         </Value>
         <Value ColumnRef="definition">
            <SimpleValue>bygværk med porte eller skodder, der kan åbnes og lukkes og derved regulere vandets løb gennem en dæmning, et dige eller et vandløb, fx en højvandssluse.</SimpleValue>
         </Value>
         <Value ColumnRef="kommentar"/>
         <Value ColumnRef="virkningFra">
            <SimpleValue>2027-02-01</SimpleValue>
         </Value>
         <Value ColumnRef="virkningTil"/>
      </Row>
      <Row>
         <Value ColumnRef="kode">
            <SimpleValue>Pumpe</SimpleValue>
         </Value>
         <Value ColumnRef="navn">
            <SimpleValue>Pumpe</SimpleValue>
         </Value>
         <Value ColumnRef="definition">
            <SimpleValue>tilpasning som aktivt løfter eller fører overfladevand gennem en forhindring, fx et dige eller en dæmning.</SimpleValue>
         </Value>
         <Value ColumnRef="kommentar">
            <SimpleValue>vandet løber kun i én retning, fra objektets startpunkt mod dets slutpunkt, dvs. i digitaliseringsretningen</SimpleValue>
         </Value>
         <Value ColumnRef="virkningFra">
            <SimpleValue>2027-02-01</SimpleValue>
         </Value>
         <Value ColumnRef="virkningTil"/>
      </Row>
   </SimpleCodeList>
</gc:CodeList>