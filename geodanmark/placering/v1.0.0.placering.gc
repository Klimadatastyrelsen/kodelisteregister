<?xml version="1.0" encoding="UTF-8"?>
<gc:CodeList xmlns:gc="http://docs.oasis-open.org/codelist/ns/genericode/1.0/"
             xmlns:dcterms="http://purl.org/dc/terms/">
   <Annotation>
      <Description>
         <dcterms:description>liste med mulige koder til angivelse af placering</dcterms:description>
         <dcterms:provenance>første version i kodelisteregisteret</dcterms:provenance>
         <dcterms:language>da</dcterms:language>
