   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/dar/noejagtighedsklasse/Absolut placeret">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/dar/noejagtighedsklasse"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/dar/noejagtighedsklasse"/>
      <skos:notation>A</skos:notation>
      <skos:prefLabel xml:lang="da">Absolut placeret</skos:prefLabel>
      <skos:definition xml:lang="da">adgangspunker og vejpunkter, der er placeret af adressemyndigheden.</skos:definition>
      <rdfs:comment xml:lang="da">Nøjagtighedsklasse for Vejpunkt/Adgangspunkt.</rdfs:comment>
      <dcterms:valid>2015-10-01/..</dcterms:valid>
   </skos:Concept>
   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/dar/noejagtighedsklasse/Beregnet placering">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/dar/noejagtighedsklasse"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/dar/noejagtighedsklasse"/>
      <skos:notation>B</skos:notation>
      <skos:prefLabel xml:lang="da">Beregnet placering</skos:prefLabel>
      <skos:definition xml:lang="da">alle vejpunkter blev beregnet da DAR blev skabt. Hvis punktet ikke er rykket siden, vil nøjagtighedklassen være B</skos:definition>
      <rdfs:comment xml:lang="da">Nøjagtighedsklasse for Vejpunkt/Adgangspunkt.</rdfs:comment>
      <dcterms:valid>2015-10-01/..</dcterms:valid>
   </skos:Concept>
   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/dar/noejagtighedsklasse/Manuelt sat, følger IKKE GeoDanmark">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/dar/noejagtighedsklasse"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/dar/noejagtighedsklasse"/>
      <skos:notation>A</skos:notation>
      <skos:prefLabel xml:lang="da">Manuelt sat, følger IKKE GeoDanmark</skos:prefLabel>
      <skos:definition xml:lang="da">navngivne veje, der ikke skal følge GeoDanmarks vejmidte</skos:definition>
      <rdfs:comment xml:lang="da">Nøjagtighedsklasse for Vejnavnebeliggenhed.</rdfs:comment>
      <dcterms:valid>2015-10-01/..</dcterms:valid>
   </skos:Concept>
   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/dar/noejagtighedsklasse/Maskinelt sat, ud fra GeoDanmark">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/dar/noejagtighedsklasse"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/dar/noejagtighedsklasse"/>
      <skos:notation>B</skos:notation>
      <skos:prefLabel xml:lang="da">Maskinelt sat, ud fra GeoDanmark</skos:prefLabel>
      <skos:definition xml:lang="da">sættes automatisk når vejnavnebeliggenheden er opdateret ud fra GeoDanmark</skos:definition>
      <rdfs:comment xml:lang="da">Nøjagtighedsklasse for Vejnavnebeliggenhed.</rdfs:comment>
      <dcterms:valid>2015-10-01/..</dcterms:valid>
   </skos:Concept>
   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/dar/noejagtighedsklasse/Manuelt sat, kommer til at følge GeoDanmark">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/dar/noejagtighedsklasse"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/dar/noejagtighedsklasse"/>
      <skos:notation>C</skos:notation>
      <skos:prefLabel xml:lang="da">Manuelt sat, kommer til at følge GeoDanmark</skos:prefLabel>
      <skos:definition xml:lang="da">manuelt placerede veje i DAR, der skal opdateres og følge GeoDanmark Vejmidter</skos:definition>
      <rdfs:comment xml:lang="da">Nøjagtighedsklasse for Vejnavnebeliggenhed.</rdfs:comment>
      <dcterms:valid>2015-10-01/..</dcterms:valid>
   </skos:Concept>
   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/dar/noejagtighedsklasse/Adressepunkt uden koordinater - stedfæstelse ukendt">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/dar/noejagtighedsklasse"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/dar/noejagtighedsklasse"/>
      <skos:notation>U</skos:notation>
      <skos:prefLabel xml:lang="da">Adressepunkt uden koordinater - stedfæstelse ukendt</skos:prefLabel>
      <skos:definition xml:lang="da">adressepunktet er ikke stedfæstet med koordinater</skos:definition>
      <rdfs:comment xml:lang="da">Kan forekomme for historiske Adressepunkter (adgangspunkter).</rdfs:comment>
      <dcterms:valid>2015-10-01/..</dcterms:valid>
   </skos:Concept>
</rdf:RDF>