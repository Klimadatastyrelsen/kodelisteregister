   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/geometristatus/Endelig">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/geometristatus"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/geometristatus"/>
      <skos:notation>Endelig</skos:notation>
      <skos:prefLabel xml:lang="da">Endelig</skos:prefLabel>
      <skos:definition xml:lang="da">geometrien er endelig og fuldt tilfredsstillende fastlagt</skos:definition>
      <rdfs:comment xml:lang="da">med denne værdi signaleres, at datas geometriske kvalitet er fuldt tilfredsstillende i forhold til den angivne etableringsmetode og at geometrien er endeligt fastlagt. Der er således ikke tale om registrering af planlagte forhold i terrænet. Alene forhold, der allerede findes i terrænet og er endeligt stedbestemt i plan og højde, må kaldes ”Endelig”. Ved landmåling (inkl. kote) eller ved fotogrammetri skal denne værdi altid anvendes</rdfs:comment>
      <dcterms:valid>2027-02-01/..</dcterms:valid>
   </skos:Concept>
   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/geometristatus/Foreløbig">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/geometristatus"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/geometristatus"/>
      <skos:notation>Foreløbig</skos:notation>
      <skos:prefLabel xml:lang="da">Foreløbig</skos:prefLabel>
      <skos:definition xml:lang="da">geometrien er foreløbig og ikke tilfredsstillende fastlagt</skos:definition>
      <rdfs:comment xml:lang="da">værdien "Foreløbig" betyder, at objektets geometri ikke er endeligt fastlagt endnu. Disse foreløbige geometrier kan automatisk udpeges til at blive endeligt opmålt eller verificeret i forbindelse med førstkommende ajourføring ved landmåling eller fotogrammetri. Hvor det indlagte objekt enten er: planlagt / projekttegninger, digitaliseret ud fra ortofoto, under etablering, uden en valid Z-koordinat skal dets geometri derfor indmeldes som ”Foreløbig”</rdfs:comment>
      <dcterms:valid>2027-02-01/..</dcterms:valid>
   </skos:Concept>
</rdf:RDF>