   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/kystbeskyttelsestype/Høfde">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/kystbeskyttelsestype"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/kystbeskyttelsestype"/>
      <skos:notation>Høfde</skos:notation>
      <skos:prefLabel xml:lang="da">Høfde</skos:prefLabel>
      <skos:definition xml:lang="da">en langstrakt, smal konstruktion bygget vinkelret ud fra stranden og ud i vandet for at beskytte kysten mod bølgeerosion og sandvandring</skos:definition>
      <rdfs:comment xml:lang="da">høfde er anlagt vinkelret ud fra Kyst</rdfs:comment>
      <dcterms:valid>2027-02-01/..</dcterms:valid>
   </skos:Concept>
   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/kystbeskyttelsestype/Bølgebryder">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/kystbeskyttelsestype"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/kystbeskyttelsestype"/>
      <skos:notation>Bølgebryder</skos:notation>
      <skos:prefLabel xml:lang="da">Bølgebryder</skos:prefLabel>
      <skos:definition xml:lang="da">konstruktion i vandet – typisk bygget af sten eller beton – som har til formål at dæmpe bølgeslag og skabe roligt vand bag sig</skos:definition>
      <rdfs:comment xml:lang="da">bølgebryder er anlagt parallelt med Kyst</rdfs:comment>
      <dcterms:valid>2027-02-01/..</dcterms:valid>
   </skos:Concept>
   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/kystbeskyttelsestype/Slikgård">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/kystbeskyttelsestype"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/kystbeskyttelsestype"/>
      <skos:notation>Slikgård</skos:notation>
      <skos:prefLabel xml:lang="da">Slikgård</skos:prefLabel>
      <skos:definition xml:lang="da">indhegnet område på tidevandskyst, der bruges til landvinding</skos:definition>
      <dcterms:valid>2027-02-01/..</dcterms:valid>
   </skos:Concept>
   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/kystbeskyttelsestype/Andet">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/kystbeskyttelsestype"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/kystbeskyttelsestype"/>
      <skos:notation>Andet</skos:notation>
      <skos:prefLabel xml:lang="da">Andet</skos:prefLabel>
      <skos:definition xml:lang="da">kystbeskyttelseskonstruktion, som ikke kan identificeres som én af de overstående kategorier</skos:definition>
      <dcterms:valid>2027-02-01/..</dcterms:valid>
   </skos:Concept>
