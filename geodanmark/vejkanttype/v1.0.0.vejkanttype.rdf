   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/Kørevej">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark"/>
      <skos:notation>Kørevej</skos:notation>
      <skos:prefLabel xml:lang="da">Kørevej</skos:prefLabel>
      <skos:definition xml:lang="da">færdselsareal på vej, bro, sti eller plads som skønnes at være åben for almindelig færdsel samt adgangsvej til mere end én ejendom</skos:definition>
      <dcterms:valid>2027-02-01/..</dcterms:valid>
   </skos:Concept>
   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/Adgangsvej">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark"/>
      <skos:notation>Adgangsvej</skos:notation>
      <skos:prefLabel xml:lang="da">Adgangsvej</skos:prefLabel>
      <skos:definition xml:lang="da">kanten af en vej, der er adgangsvej til en enkelt ejendom og dermed forbinder ejendommen med den vej, hvortil dens adresse hører</skos:definition>
      <dcterms:valid>2027-02-01/..</dcterms:valid>
   </skos:Concept>
   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/Parkering">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark"/>
      <skos:notation>Parkering</skos:notation>
      <skos:prefLabel xml:lang="da">Parkering</skos:prefLabel>
      <skos:definition xml:lang="da">kant af selvstændigt parkeringsområde
Parkering i tilknytning til større enhed: institution, indkøbscenter, idrætsanlæg, jernbanestation, seværdighed eller lignende
Parkeringsområde i forbindelse med boligblok, rækkehuse samt på torv, i bycenter og på taget af en bygning</skos:definition>
      <dcterms:valid>2027-02-01/..</dcterms:valid>
   </skos:Concept>
   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/Internvej">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark"/>
      <skos:notation>Internvej</skos:notation>
      <skos:prefLabel xml:lang="da">Internvej</skos:prefLabel>
      <skos:definition xml:lang="da">internt færdselsareal ved boligblok, institution, industrigrund, lufthavn, kirkegård og lignende. Men ikke færdselsareal på parcelhusgrund
 </skos:definition>
      <dcterms:valid>2027-02-01/..</dcterms:valid>
   </skos:Concept>
   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/Anden vej">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark"/>
      <skos:notation>Anden vej</skos:notation>
      <skos:prefLabel xml:lang="da">Anden vej</skos:prefLabel>
      <skos:definition xml:lang="da">kant af små veje med lille betydning.
Ofte korte og blinde veje, der betjener bagsiden af bygninger, baggårde, interne parkeringsarealer og lignende</skos:definition>
      <dcterms:valid>2027-02-01/..</dcterms:valid>
   </skos:Concept>
   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/Supplerende Vejkant">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark"/>
      <skos:notation>Supplerende Vejkant</skos:notation>
      <skos:prefLabel xml:lang="da">Supplerende Vejkant</skos:prefLabel>
      <skos:definition xml:lang="da">supplerende linjer uden for færdselsarealet i forbindelse med buslomme eller rundkørsel samt ved vende- og parkeringsareal langs vej</skos:definition>
      <rdfs:comment xml:lang="da">Registreres ikke fotogrammetrisk, da kommunen selv skal registrere disse.   Registreres kun administrativt.</rdfs:comment>
      <dcterms:valid>2027-02-01/..</dcterms:valid>
   </skos:Concept>
   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/Helle">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark"/>
      <skos:notation>Helle</skos:notation>
      <skos:prefLabel xml:lang="da">Helle</skos:prefLabel>
      <skos:definition xml:lang="da">omrids af helleanlæg i forbindelse med kryds, svingbaner og fodgængerovergang
Helle har kørende 4-hjulet trafik på begge sider. Hvis der på den ene side af et trafik-skille-område kun forekommer 2-hjulet trafik, er området ikke Helle med Chikane</skos:definition>
      <dcterms:valid>2027-02-01/..</dcterms:valid>
   </skos:Concept>
   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/Cykelsti langs vej">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark"/>
      <skos:notation>Cykelsti langs vej</skos:notation>
      <skos:prefLabel xml:lang="da">Cykelsti langs vej</skos:prefLabel>
      <skos:definition xml:lang="da">kant af færdselsareal primært til brug for cykler. Færdselsarealet grænser op til Kørevej/Internvej eller en rabat langs kørebanen. Sti kun for cyklende og langsomt kørende motoriseret to-/trehjulet trafik
 </skos:definition>
      <dcterms:valid>2027-02-01/..</dcterms:valid>
   </skos:Concept>
   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/Gennemgående sti">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark"/>
      <skos:notation>Gennemgående sti</skos:notation>
      <skos:prefLabel xml:lang="da">Gennemgående sti</skos:prefLabel>
      <skos:definition xml:lang="da">kant af færdselsareal i form af gennemgående sti i eget tracé, herunder overordnet sti, der tjener til fordelingsnet for mindre sidestier</skos:definition>
      <dcterms:valid>2027-02-01/..</dcterms:valid>
   </skos:Concept>
   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/Lokal sti">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark"/>
      <skos:notation>Lokal sti</skos:notation>
      <skos:prefLabel xml:lang="da">Lokal sti</skos:prefLabel>
      <skos:definition xml:lang="da">intern eller mindre sti</skos:definition>
      <dcterms:valid>2027-02-01/..</dcterms:valid>
   </skos:Concept>
   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/Ikke tildelt">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark"/>
      <skos:notation>Ikke tildelt</skos:notation>
      <skos:prefLabel xml:lang="da">Ikke tildelt</skos:prefLabel>
      <skos:definition xml:lang="da">typen af Vejkant er ikke tildelt</skos:definition>
      <dcterms:valid>2027-02-01/..</dcterms:valid>
   </skos:Concept>
   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/Ukendt">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark"/>
      <skos:notation>Ukendt</skos:notation>
      <skos:prefLabel xml:lang="da">Ukendt</skos:prefLabel>
      <skos:definition xml:lang="da">typen af Vejkant er ikke kendt</skos:definition>
      <dcterms:valid>2027-02-01/..</dcterms:valid>
   </skos:Concept>
</rdf:RDF>