   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/forretningshaendelse/Nyt objekt">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/forretningshaendelse"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/forretningshaendelse"/>
      <skos:notation>Nyt objekt</skos:notation>
      <skos:prefLabel xml:lang="da">Nyt objekt</skos:prefLabel>
      <skos:definition xml:lang="da">der er opstået et objekt med en ny ident</skos:definition>
      <rdfs:comment xml:lang="da">objektet er nyt. Der kan godt have været et andet objekt af samme type omtrent samme sted, men dette er blevet slettet</rdfs:comment>
      <dcterms:valid>2027-02-01/..</dcterms:valid>
   </skos:Concept>
   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/forretningshaendelse/Ændret geometri">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/forretningshaendelse"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/forretningshaendelse"/>
      <skos:notation>Ændret geometri</skos:notation>
      <skos:prefLabel xml:lang="da">Ændret geometri</skos:prefLabel>
      <skos:definition xml:lang="da">et eksisterende objekt har beholdt sin ident, men har fået ændret på geometrien</skos:definition>
      <rdfs:comment xml:lang="da">et eksisterende objekt har fået ændret hele eller dele af sin geometri. Den geometriske rettelse omhandler måske kun Z. 'id.lokalId' for objektet er uændret</rdfs:comment>
      <dcterms:valid>2027-02-01/..</dcterms:valid>
   </skos:Concept>
   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/forretningshaendelse/Ændret attribut">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/forretningshaendelse"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/forretningshaendelse"/>
      <skos:notation>Ændret attribut</skos:notation>
      <skos:prefLabel xml:lang="da">Ændret attribut</skos:prefLabel>
      <skos:definition xml:lang="da">et eksisterende objekt har beholdt sin ident, men har fået ændret på en eller flere af sine attributværdier</skos:definition>
      <rdfs:comment xml:lang="da">et eksisterende objekt har fået ændret en eller flere attributværdier. 'id.lokalId' for objektet er uændret</rdfs:comment>
      <dcterms:valid>2027-02-01/..</dcterms:valid>
   </skos:Concept>
   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/forretningshaendelse/Ændret geometri og attribut">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/forretningshaendelse"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/forretningshaendelse"/>
      <skos:notation>Ændret geometri og attribut</skos:notation>
      <skos:prefLabel xml:lang="da">Ændret geometri og attribut</skos:prefLabel>
      <skos:definition xml:lang="da">et eksisterende objekt har beholdt sin ident, men har fået ændret på geometrien og en eller flere af sine attributværdier</skos:definition>
      <dcterms:valid>2027-02-01/..</dcterms:valid>
   </skos:Concept>
   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/forretningshaendelse/Nedlagt objekt">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/forretningshaendelse"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/forretningshaendelse"/>
      <skos:notation>Nedlagt objekt</skos:notation>
      <skos:prefLabel xml:lang="da">Nedlagt objekt</skos:prefLabel>
      <skos:definition xml:lang="da">objektet er gjort historisk</skos:definition>
      <rdfs:comment xml:lang="da">objektet er logisk slettet</rdfs:comment>
      <dcterms:valid>2027-02-01/..</dcterms:valid>
   </skos:Concept>
</rdf:RDF>