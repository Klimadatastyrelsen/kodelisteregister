   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/bbraktion/Skal i BBR">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/bbraktion"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/bbraktion"/>
      <skos:notation>Skal i BBR</skos:notation>
      <skos:prefLabel xml:lang="da">Skal i BBR</skos:prefLabel>
      <skos:definition xml:lang="da">bygningen skal i BBR</skos:definition>
      <rdfs:comment xml:lang="da">der skal oprettes én bygning eller ét tekniskanlæg i BBR, som dette Geodanmark objekt kan kobles til</rdfs:comment>
      <dcterms:valid>2027-02-01/..</dcterms:valid>
   </skos:Concept>
   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/bbraktion/Skal ikke i BBR">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/bbraktion"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/bbraktion"/>
      <skos:notation>Skal ikke i BBR</skos:notation>
      <skos:prefLabel xml:lang="da">Skal ikke i BBR</skos:prefLabel>
      <skos:definition xml:lang="da">bygningen skal ikke i BBR</skos:definition>
      <rdfs:comment xml:lang="da">der skal IKKE oprettes hverken én bygning eller ét tekniskanlæg i BBR</rdfs:comment>
      <dcterms:valid>2027-02-01/..</dcterms:valid>
   </skos:Concept>
   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/bbraktion/Skal sammenlægges">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/bbraktion"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/bbraktion"/>
      <skos:notation>Skal sammenlægges</skos:notation>
      <skos:prefLabel xml:lang="da">Skal sammenlægges</skos:prefLabel>
      <skos:definition xml:lang="da">sammenlægges med andre objekter af samme type</skos:definition>
      <rdfs:comment xml:lang="da">dette Geodanmark objekt skal sammenlægges med et eller flere andre Geodanmark objekter af samme type. For at kunne matche én bygning eller ét tekniskanlæg i BBR</rdfs:comment>
      <dcterms:valid>2027-02-01/..</dcterms:valid>
   </skos:Concept>
   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/bbraktion/Del af et BBR-objekt">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/bbraktion"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/bbraktion"/>
      <skos:notation>Del af et BBR-objekt</skos:notation>
      <skos:prefLabel xml:lang="da">Del af et BBR-objekt</skos:prefLabel>
      <skos:definition xml:lang="da">objekter kan ikke sammenlægges, fordi de ikke hænger fysisk sammen</skos:definition>
      <rdfs:comment xml:lang="da">dette er ét af flere Geodanmark objekter, der samlet set matcher én bygning eller ét tekniskanlæg i BBR, men hvor Geodanmark objekterne ikke kan lægges sammen, da de ikke har fysisk sammenfald</rdfs:comment>
      <dcterms:valid>2027-02-01/..</dcterms:valid>
   </skos:Concept>
   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/bbraktion/Mangler afklaring">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/bbraktion"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/bbraktion"/>
      <skos:notation>Mangler afklaring</skos:notation>
      <skos:prefLabel xml:lang="da">Mangler afklaring</skos:prefLabel>
      <skos:definition xml:lang="da">det er ikke afklaret, hvad der videre skal ske med bygningen</skos:definition>
      <dcterms:valid>2027-02-01/..</dcterms:valid>
   </skos:Concept>
</rdf:RDF>