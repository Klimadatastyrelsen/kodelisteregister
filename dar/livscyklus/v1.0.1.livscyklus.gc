         <dcterms:license>https://creativecommons.org/licenses/by/4.0/deed.da</dcterms:license>
         <dcterms:available>2026-05-06</dcterms:available>
      </Description>
   </Annotation>
   <Identification>
      <ShortName>livscyklus</ShortName>
      <Version>1.0.1</Version>
      <CanonicalUri>urn:uuid:bad27b41-ae5b-4d2b-98ae-da4d2d3adba4</CanonicalUri>
      <CanonicalVersionUri>urn:uuid:135800cc-3012-4fde-b4d9-70aea0ec8a09</CanonicalVersionUri>
      <LocationUri>https://klimadatastyrelsen.github.io/kodelisteregister/dar/livscyklus/v1.0.1.livscyklus.gc</LocationUri>
      <AlternateFormatLocationUri MimeType="text/csv">https://klimadatastyrelsen.github.io/kodelisteregister/dar/livscyklus/v1.0.1.livscyklus.csv</AlternateFormatLocationUri>
      <AlternateFormatLocationUri MimeType="text/html">https://klimadatastyrelsen.github.io/kodelisteregister/dar/livscyklus/v1.0.1.livscyklus.html</AlternateFormatLocationUri>
