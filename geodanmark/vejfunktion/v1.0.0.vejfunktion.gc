   <SimpleCodeList>
      <Row>
         <Value ColumnRef="kode">
            <SimpleValue>Motorvej</SimpleValue>
         </Value>
         <Value ColumnRef="navn">
            <SimpleValue>Motorvej</SimpleValue>
         </Value>
         <Value ColumnRef="definition">
            <SimpleValue>veje, der er anlagt efter reglerne for motorvej</SimpleValue>
         </Value>
         <Value ColumnRef="kommentar"/>
         <Value ColumnRef="virkningFra">
            <SimpleValue>2027-02-01</SimpleValue>
         </Value>
         <Value ColumnRef="virkningTil"/>
      </Row>
      <Row>
         <Value ColumnRef="kode">
            <SimpleValue>Motortrafikvej</SimpleValue>
         </Value>
         <Value ColumnRef="navn">
            <SimpleValue>Motortrafikvej</SimpleValue>
         </Value>
         <Value ColumnRef="definition">
            <SimpleValue>veje, der er anlagt efter reglerne for motortrafikvej</SimpleValue>
         </Value>
         <Value ColumnRef="kommentar"/>
         <Value ColumnRef="virkningFra">
            <SimpleValue>2027-02-01</SimpleValue>
         </Value>
         <Value ColumnRef="virkningTil"/>
      </Row>
      <Row>
         <Value ColumnRef="kode">
            <SimpleValue>Vej</SimpleValue>
         </Value>
         <Value ColumnRef="navn">
            <SimpleValue>Vej</SimpleValue>
         </Value>
         <Value ColumnRef="definition">
            <SimpleValue>øvrige veje hvis funktion IKKE kan gå ind under en af denne listes værdier</SimpleValue>
         </Value>
         <Value ColumnRef="kommentar"/>
         <Value ColumnRef="virkningFra">
            <SimpleValue>2027-02-01</SimpleValue>
         </Value>
         <Value ColumnRef="virkningTil"/>
      </Row>
      <Row>
         <Value ColumnRef="kode">
            <SimpleValue>Rundkørsel</SimpleValue>
         </Value>
         <Value ColumnRef="navn">
            <SimpleValue>Rundkørsel</SimpleValue>
         </Value>
         <Value ColumnRef="definition">
            <SimpleValue>cirkulært køreareal i et vejkryds, hvor færdslen reguleres mod uret</SimpleValue>
         </Value>
         <Value ColumnRef="kommentar"/>
         <Value ColumnRef="virkningFra">
            <SimpleValue>2027-02-01</SimpleValue>
         </Value>
         <Value ColumnRef="virkningTil"/>
      </Row>
      <Row>
         <Value ColumnRef="kode">
            <SimpleValue>Parkering</SimpleValue>
         </Value>
         <Value ColumnRef="navn">
            <SimpleValue>Parkering</SimpleValue>
         </Value>
         <Value ColumnRef="definition">
            <SimpleValue>små ikke-gennemkørende veje på parkerings- og rastepladser</SimpleValue>
         </Value>
         <Value ColumnRef="kommentar"/>
         <Value ColumnRef="virkningFra">
            <SimpleValue>2027-02-01</SimpleValue>
         </Value>
         <Value ColumnRef="virkningTil"/>
      </Row>
      <Row>
         <Value ColumnRef="kode">
            <SimpleValue>Frakørsel</SimpleValue>
         </Value>
         <Value ColumnRef="navn">
            <SimpleValue>Frakørsel</SimpleValue>
         </Value>
         <Value ColumnRef="definition">
            <SimpleValue>ensrettet forbindelsesvej i eget tracé, der muliggør skift mellem veje ofte placeret i forskellige niveauer. Forløbet starter ved primærvejens udfletningspunkt (frakørsel) og afsluttes ved primærvejens sammenfletningspunkt (tilkørsel)</SimpleValue>
         </Value>
         <Value ColumnRef="kommentar"/>
         <Value ColumnRef="virkningFra">
            <SimpleValue>2027-02-01</SimpleValue>
         </Value>
         <Value ColumnRef="virkningTil"/>
      </Row>
      <Row>
         <Value ColumnRef="kode">
            <SimpleValue>Tilkørsel</SimpleValue>
         </Value>
         <Value ColumnRef="navn">
            <SimpleValue>Tilkørsel</SimpleValue>
         </Value>
         <Value ColumnRef="definition">
            <SimpleValue>ensrettet forbindelsesvej i eget tracé, der muliggør skift mellem veje ofte placeret i forskellige niveauer. Forløbet starter ved tilslutning fra det øvrige vejnet og afsluttes ved primærvejens sammenfletningspunkt (tilkørsel)</SimpleValue>
         </Value>
         <Value ColumnRef="kommentar"/>
         <Value ColumnRef="virkningFra">
            <SimpleValue>2027-02-01</SimpleValue>
         </Value>
         <Value ColumnRef="virkningTil"/>
      </Row>
      <Row>
         <Value ColumnRef="kode">
            <SimpleValue>Øvrige rampe</SimpleValue>
         </Value>
         <Value ColumnRef="navn">
            <SimpleValue>Øvrige rampe</SimpleValue>
         </Value>
         <Value ColumnRef="definition">
            <SimpleValue>rampe med dobbeltrettet færdsel</SimpleValue>
         </Value>
         <Value ColumnRef="kommentar"/>
         <Value ColumnRef="virkningFra">
            <SimpleValue>2027-02-01</SimpleValue>
         </Value>
         <Value ColumnRef="virkningTil"/>
      </Row>
      <Row>
         <Value ColumnRef="kode">
            <SimpleValue>Parallelspor</SimpleValue>
         </Value>
         <Value ColumnRef="navn">
            <SimpleValue>Parallelspor</SimpleValue>
         </Value>
         <Value ColumnRef="definition">
            <SimpleValue>separat kørebane placeret umiddelbart uden for de normale kørebaner og parallelt med disse (typisk langs motorvej). Parallelsporet bruges til at adskille flettetrafik fra den gennemgående, og adgangen sker ofte via ind- og udfletning</SimpleValue>
         </Value>
         <Value ColumnRef="kommentar"/>
         <Value ColumnRef="virkningFra">
            <SimpleValue>2027-02-01</SimpleValue>
         </Value>
         <Value ColumnRef="virkningTil"/>
      </Row>
      <Row>
         <Value ColumnRef="kode">
            <SimpleValue>Shunt</SimpleValue>
         </Value>
         <Value ColumnRef="navn">
            <SimpleValue>Shunt</SimpleValue>
         </Value>
         <Value ColumnRef="definition">
            <SimpleValue>kort forbindelsesvej i eget tracé, der lader trafik svinge til højre uden at skulle ind i selve krydset eller rundkørslen. Shunts har altid ensrettet færdsel</SimpleValue>
         </Value>
         <Value ColumnRef="kommentar"/>
         <Value ColumnRef="virkningFra">
            <SimpleValue>2027-02-01</SimpleValue>
         </Value>
         <Value ColumnRef="virkningTil"/>
      </Row>
      <Row>
         <Value ColumnRef="kode">
            <SimpleValue>Cykelsti</SimpleValue>
         </Value>
         <Value ColumnRef="navn">
            <SimpleValue>Cykelsti</SimpleValue>
         </Value>
         <Value ColumnRef="definition">
            <SimpleValue>trafikken er kun for cyklende færdsel</SimpleValue>
         </Value>
         <Value ColumnRef="kommentar"/>
         <Value ColumnRef="virkningFra">
            <SimpleValue>2027-02-01</SimpleValue>
         </Value>
         <Value ColumnRef="virkningTil"/>
      </Row>
      <Row>
         <Value ColumnRef="kode">
            <SimpleValue>Gangsti</SimpleValue>
         </Value>
         <Value ColumnRef="navn">
            <SimpleValue>Gangsti</SimpleValue>
         </Value>
         <Value ColumnRef="definition">
            <SimpleValue>trafikken er kun for gående færdsel</SimpleValue>
         </Value>
         <Value ColumnRef="kommentar"/>
         <Value ColumnRef="virkningFra">
            <SimpleValue>2027-02-01</SimpleValue>
         </Value>
         <Value ColumnRef="virkningTil"/>
      </Row>
      <Row>
         <Value ColumnRef="kode">
            <SimpleValue>Fællessti</SimpleValue>
         </Value>
         <Value ColumnRef="navn">
            <SimpleValue>Fællessti</SimpleValue>
         </Value>
         <Value ColumnRef="definition">
            <SimpleValue>sti beregnet til både cyklister og fodgængere uden fysisk adskillelse mellem trafikarterne</SimpleValue>
         </Value>
         <Value ColumnRef="kommentar"/>
         <Value ColumnRef="virkningFra">
            <SimpleValue>2027-02-01</SimpleValue>
         </Value>
         <Value ColumnRef="virkningTil"/>
      </Row>
      <Row>
         <Value ColumnRef="kode">
            <SimpleValue>Cykelbane</SimpleValue>
         </Value>
         <Value ColumnRef="navn">
            <SimpleValue>Cykelbane</SimpleValue>
         </Value>
         <Value ColumnRef="definition">
            <SimpleValue>sti, der forløber langs en vej kun adskilt fra kørebanen med en (mindst 30 cm.) bred bemaling. Kun for cyklende trafik. Cykelbanen har normalt samme 'kommunekode' og 'vejkode' som den vej, den løber langs. Der er malet cykelsymboler på stiens asfalt langs stiens forløb</SimpleValue>
         </Value>
         <Value ColumnRef="kommentar"/>
         <Value ColumnRef="virkningFra">
            <SimpleValue>2027-02-01</SimpleValue>
         </Value>
         <Value ColumnRef="virkningTil"/>
      </Row>
      <Row>
         <Value ColumnRef="kode">
            <SimpleValue>Rekreativ sti</SimpleValue>
         </Value>
         <Value ColumnRef="navn">
            <SimpleValue>Rekreativ sti</SimpleValue>
         </Value>
         <Value ColumnRef="definition">
            <SimpleValue>sti som IKKE kan placeres under én af de andre værdier for sti. Det kunne for eksempel være ridestier.</SimpleValue>
         </Value>
         <Value ColumnRef="kommentar"/>
         <Value ColumnRef="virkningFra">
            <SimpleValue>2027-02-01</SimpleValue>
         </Value>
         <Value ColumnRef="virkningTil"/>
      </Row>
      <Row>
         <Value ColumnRef="kode">
            <SimpleValue>Bred kantbane</SimpleValue>
         </Value>
         <Value ColumnRef="navn">
            <SimpleValue>Bred kantbane</SimpleValue>
         </Value>
         <Value ColumnRef="definition">
            <SimpleValue>sti, der forløber langs en vej kun adskilt fra kørebanen med en bemaling. Kun for cyklende trafik. Kantbanen har normalt samme 'kommunekode' og 'vejkode' som den vej, den løber langs. Der er ikke malet cykelsymboler på stiens asfalt langs stiens forløb og stibredden er mindre end for "Cykelbane"</SimpleValue>
         </Value>
         <Value ColumnRef="kommentar"/>
         <Value ColumnRef="virkningFra">
            <SimpleValue>2027-02-01</SimpleValue>
         </Value>
         <Value ColumnRef="virkningTil"/>
      </Row>
      <Row>
         <Value ColumnRef="kode">
            <SimpleValue>Ikke tildelt</SimpleValue>
         </Value>
         <Value ColumnRef="navn">
            <SimpleValue>Ikke tildelt</SimpleValue>
         </Value>
         <Value ColumnRef="definition">
            <SimpleValue>tildelingen mangler</SimpleValue>
         </Value>
         <Value ColumnRef="kommentar"/>
         <Value ColumnRef="virkningFra">
            <SimpleValue>2027-02-01</SimpleValue>
         </Value>
         <Value ColumnRef="virkningTil"/>
      </Row>
      <Row>
         <Value ColumnRef="kode">
            <SimpleValue>Ukendt</SimpleValue>
         </Value>
         <Value ColumnRef="navn">
            <SimpleValue>Ukendt</SimpleValue>
         </Value>
         <Value ColumnRef="definition">
            <SimpleValue>type kendes ikke</SimpleValue>
         </Value>
         <Value ColumnRef="kommentar"/>
         <Value ColumnRef="virkningFra">
            <SimpleValue>2027-02-01</SimpleValue>
         </Value>
         <Value ColumnRef="virkningTil"/>
      </Row>
   </SimpleCodeList>
</gc:CodeList>