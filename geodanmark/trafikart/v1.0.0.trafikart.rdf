   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/trafikart/Motorkøretøj">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/trafikart"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/trafikart"/>
      <skos:notation>Motorkøretøj</skos:notation>
      <skos:prefLabel xml:lang="da">Motorkøretøj</skos:prefLabel>
      <skos:definition xml:lang="da">kun færdsel af køretøj, der hovedsageligt er indrettet til selvstændigt at benyttes til person- eller godstransport. Minimumshastigheden er 45 km/t</skos:definition>
      <dcterms:valid>2027-02-01/..</dcterms:valid>
   </skos:Concept>
   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/trafikart/Al færdsel">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/trafikart"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/trafikart"/>
      <skos:notation>Al færdsel</skos:notation>
      <skos:prefLabel xml:lang="da">Al færdsel</skos:prefLabel>
      <skos:definition xml:lang="da">her foregår alle former for trafik</skos:definition>
      <dcterms:valid>2027-02-01/..</dcterms:valid>
   </skos:Concept>
   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/trafikart/2 minus 1 vej">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/trafikart"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/trafikart"/>
      <skos:notation>2 minus 1 vej</skos:notation>
      <skos:prefLabel xml:lang="da">2 minus 1 vej</skos:prefLabel>
      <skos:definition xml:lang="da">en vej med kun et spor for bilister. Kørebanen er på begge sider afmærket med brede, stiplede malede kanter. Området i midten er beregnet for biler, mens områderne i siderne er beregnet for cykler. Biler må dog godt parkere og køre ind over for kantbemalingen</skos:definition>
      <rdfs:comment xml:lang="da">der registreres kun én linje i midten af den samlede vejbredde. Der registreres ikke en Vejmidte i cykelområderne. Ajourføres administrativt</rdfs:comment>
      <dcterms:valid>2027-02-01/..</dcterms:valid>
   </skos:Concept>
   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/trafikart/Sideanlæg">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/trafikart"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/trafikart"/>
      <skos:notation>Sideanlæg</skos:notation>
      <skos:prefLabel xml:lang="da">Sideanlæg</skos:prefLabel>
      <skos:definition xml:lang="da">anlæg ved vejen er faciliteter, som rastepladser, tankstationer og serviceanlæg</skos:definition>
      <dcterms:valid>2027-02-01/..</dcterms:valid>
   </skos:Concept>
   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/trafikart/Gågade">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/trafikart"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/trafikart"/>
      <skos:notation>Gågade</skos:notation>
      <skos:prefLabel xml:lang="da">Gågade</skos:prefLabel>
      <skos:definition xml:lang="da">trafikken er en gående</skos:definition>
      <rdfs:comment xml:lang="da">bruges kun, når vejen er skiltet som gågade. Det er typisk gader i bymidter, som har vejnavn og adresser</rdfs:comment>
      <dcterms:valid>2027-02-01/..</dcterms:valid>
   </skos:Concept>
   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/trafikart/Cykelgade">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/trafikart"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/trafikart"/>
      <skos:notation>Cykelgade</skos:notation>
      <skos:prefLabel xml:lang="da">Cykelgade</skos:prefLabel>
      <skos:definition xml:lang="da">trafikken er en cyklende</skos:definition>
      <rdfs:comment xml:lang="da">bruges kun, når vejen er skiltet som cykelgade</rdfs:comment>
      <dcterms:valid>2027-02-01/..</dcterms:valid>
   </skos:Concept>
   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/trafikart/Cykel- og gangsti">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/trafikart"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/trafikart"/>
      <skos:notation>Cykel- og gangsti</skos:notation>
      <skos:prefLabel xml:lang="da">Cykel- og gangsti</skos:prefLabel>
      <skos:definition xml:lang="da">trafikken er både gående og cyklende færdsel</skos:definition>
      <dcterms:valid>2027-02-01/..</dcterms:valid>
   </skos:Concept>
   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/trafikart/Gangsti">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/trafikart"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/trafikart"/>
      <skos:notation>Gangsti</skos:notation>
      <skos:prefLabel xml:lang="da">Gangsti</skos:prefLabel>
      <skos:definition xml:lang="da">trafikken er kun for gående færdsel</skos:definition>
      <rdfs:comment xml:lang="da">bruges, når stien alene er beregnet for gående</rdfs:comment>
      <dcterms:valid>2027-02-01/..</dcterms:valid>
   </skos:Concept>
   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/trafikart/Cykelsti">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/trafikart"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/trafikart"/>
      <skos:notation>Cykelsti</skos:notation>
      <skos:prefLabel xml:lang="da">Cykelsti</skos:prefLabel>
      <skos:definition xml:lang="da">trafikken er kun for cyklende færdsel</skos:definition>
      <rdfs:comment xml:lang="da">cykelstier langs vej og cykelstier i eget tracé</rdfs:comment>
      <dcterms:valid>2027-02-01/..</dcterms:valid>
   </skos:Concept>
   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/trafikart/Redningsvej">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/trafikart"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/trafikart"/>
      <skos:notation>Redningsvej</skos:notation>
      <skos:prefLabel xml:lang="da">Redningsvej</skos:prefLabel>
      <skos:definition xml:lang="da">trafikken er kun for redningskørsel</skos:definition>
      <dcterms:valid>2027-02-01/..</dcterms:valid>
   </skos:Concept>
   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/trafikart/Bus">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/trafikart"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/trafikart"/>
      <skos:notation>Bus</skos:notation>
      <skos:prefLabel xml:lang="da">Bus</skos:prefLabel>
      <skos:definition xml:lang="da">trafikken er kun for busser</skos:definition>
      <dcterms:valid>2027-02-01/..</dcterms:valid>
   </skos:Concept>
   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/trafikart/Ikke tildelt">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/trafikart"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/trafikart"/>
      <skos:notation>Ikke tildelt</skos:notation>
      <skos:prefLabel xml:lang="da">Ikke tildelt</skos:prefLabel>
      <skos:definition xml:lang="da">tildelingen mangler</skos:definition>
      <dcterms:valid>2027-02-01/..</dcterms:valid>
   </skos:Concept>
</rdf:RDF>