   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/bebyggelsestype/Lav bebyggelse">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/bebyggelsestype"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/bebyggelsestype"/>
      <skos:notation>Lav bebyggelse</skos:notation>
      <skos:prefLabel xml:lang="da">Lav bebyggelse</skos:prefLabel>
      <skos:definition xml:lang="da">områder fortrinsvist bebygget med 1 og 2 etagers bygninger</skos:definition>
      <rdfs:comment xml:lang="da">hvor der ligger fritliggende bygning, eksempelvis rækkehus, parcelhus, serviceerhverv, skole samt gård på landet, inkluderes dette i LavBebyggelse. Disse områder kan udover bygninger eksempelvis også indeholde legeplads, have, græsplæne, bevoksning, fællesareal og parkeringsplads samt tank, silo, mødding og område til landbrugsredskaber, hvis arealet er af permanent karakter. Desuden også haveanlæg og park i forbindelse med slot eller herregård. LavBebyggelse optræder kun med et areal ≥ 2.500 m2 indenfor områdepolygon og udenfor områdepolygon kun med et areal &gt;500 m2</rdfs:comment>
      <dcterms:valid>2027-02-01/..</dcterms:valid>
   </skos:Concept>
   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/bebyggelsestype/Høj bebyggelse">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/bebyggelsestype"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/bebyggelsestype"/>
      <skos:notation>Høj bebyggelse</skos:notation>
      <skos:prefLabel xml:lang="da">Høj bebyggelse</skos:prefLabel>
      <skos:definition xml:lang="da">områder fortrinsvist bebygget med bygninger på mere end to etager, eksempelvis boligblok, karré, serviceerhverv, skole eller institution</skos:definition>
      <rdfs:comment xml:lang="da">området indeholder også legeplads, have, græsplæne, bevoksning, fællesareal, parkeringsplads og baggård. HøjBebyggelse optræder kun med et areal ≥ 2.500 m2</rdfs:comment>
      <dcterms:valid>2027-02-01/..</dcterms:valid>
   </skos:Concept>
   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/bebyggelsestype/Erhverv">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/bebyggelsestype"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/bebyggelsestype"/>
      <skos:notation>Erhverv</skos:notation>
      <skos:prefLabel xml:lang="da">Erhverv</skos:prefLabel>
      <skos:definition xml:lang="da">områder fortrinsvist bebygget med fabrikker, håndværks ejendomme, indkøbscentre og industrihavneområder</skos:definition>
      <rdfs:comment xml:lang="da">området indeholder alle de bygninger, tekniske anlæg, lagerpladser, græsarealer, parkeringsarealer og lignende områder, der umiddelbart hører med til Erhverv. Erhverv optræder kun med et areal ≥ 2.500 m2</rdfs:comment>
      <dcterms:valid>2027-02-01/..</dcterms:valid>
   </skos:Concept>
   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/bebyggelsestype/Trafikområde">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/bebyggelsestype"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/bebyggelsestype"/>
      <skos:notation>Trafikområde</skos:notation>
      <skos:prefLabel xml:lang="da">Trafikområde</skos:prefLabel>
      <skos:definition xml:lang="da">arealer i byer bestående af veje, stier, jernbane og letbane som er så brede, at de ikke vil være egnede til at repræsentere andre bebyggelsestyper</skos:definition>
      <rdfs:comment xml:lang="da">trafikområder optræder kun med et areal ≥ 2.500 m2</rdfs:comment>
      <dcterms:valid>2027-02-01/..</dcterms:valid>
   </skos:Concept>
</rdf:RDF>