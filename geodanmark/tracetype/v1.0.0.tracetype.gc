         <dcterms:available>2026-11-24</dcterms:available>
      </Description>
   </Annotation>
   <Identification>
      <ShortName>tracetype</ShortName>
      <Version>1.0.0</Version>
      <CanonicalUri>urn:uuid:74bd992f-1b20-4ea0-b37b-5645fb7cdafd</CanonicalUri>
      <CanonicalVersionUri>urn:uuid:9474b06a-0051-499b-99a6-ce3bd759db69</CanonicalVersionUri>
      <LocationUri>https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/tracetype/v1.0.0.tracetype.gc</LocationUri>
      <AlternateFormatLocationUri MimeType="text/csv">https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/tracetype/v1.0.0.tracetype.csv</AlternateFormatLocationUri>
      <AlternateFormatLocationUri MimeType="text/html">https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/tracetype/v1.0.0.tracetype.html</AlternateFormatLocationUri>
      <AlternateFormatLocationUri MimeType="application/rdf+xml">https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/tracetype/v1.0.0.tracetype.rdf</AlternateFormatLocationUri>
      <Agency>
         <LongName>GeoDanmark</LongName>
      </Agency>
   </Identification>
   <ColumnSet>
      <Column Id="kode"
              Use="required">
         <Annotation>
            <Description>
               <dcterms:description>tilladt værdi i data</dcterms:description>
            </Description>
         </Annotation>
         <ShortName>kode</ShortName>
         <Data Type="string"/>
      </Column>
      <Column Id="navn"
              Use="required">
         <Annotation>
            <Description>
               <dcterms:description>foretrukne term for koden</dcterms:description>
            </Description>
         </Annotation>
         <ShortName>navn</ShortName>
         <Data Type="string"
               Lang="da"/>
      </Column>
      <Column Id="definition"
              Use="optional">
         <Annotation>
            <Description>
               <dcterms:description>kort beskrivelse eller formel forklaring af kodens betydning</dcterms:description>
            </Description>
         </Annotation>
         <ShortName>definition</ShortName>
         <Data Type="string"
               Lang="da"/>
      </Column>
      <Column Id="kommentar"
              Use="optional">
         <Annotation>
            <Description>
               <dcterms:description>kommentar som hjælper til afklaring af forståelse af koden</dcterms:description>
            </Description>
         </Annotation>
         <ShortName>kommentar</ShortName>
         <Data Type="string"
               Lang="da"/>
      </Column>
      <Column Id="virkningFra"
              Use="required">
         <Annotation>
            <Description>
               <dcterms:description>tidspunkt for hvornår koden må tages i anvendelse for nye registreringer</dcterms:description>
            </Description>
         </Annotation>
         <ShortName>virkningFra</ShortName>
         <Data Type="date"/>
      </Column>
      <Column Id="virkningTil"
              Use="optional">
         <Annotation>
            <Description>
               <dcterms:description>tidspunkt for hvornår koden ikke længere må anvendes i nye registreringer. Koden kan eksistere i data, der er registreret før dette tidspunkt</dcterms:description>
            </Description>
         </Annotation>
         <ShortName>virkningTil</ShortName>
         <Data Type="date"/>
      </Column>
      <Key Id="key_code">
         <ShortName>key_code</ShortName>
         <ColumnRef Ref="kode"/>
      </Key>
      <Key Id="key_navn">
         <ShortName>key_navn</ShortName>
         <ColumnRef Ref="navn"/>
      </Key>
   </ColumnSet>
   <SimpleCodeList>
      <Row>
         <Value ColumnRef="kode">
            <SimpleValue>Vej i delt tracé</SimpleValue>
         </Value>
         <Value ColumnRef="navn">
            <SimpleValue>Vej i delt tracé</SimpleValue>
         </Value>
         <Value ColumnRef="definition">
            <SimpleValue>vej med dobbeltrettet færdsel, hvor kørebanerne er samlet uden fysisk adskillelse (som f.eks. midterrabat) mellem retningerne</SimpleValue>
         </Value>
         <Value ColumnRef="kommentar">
            <SimpleValue>dækker over almindelige veje, hvor modkørende trafik deler det samme færdselsareal, og vejen derfor registreres med én fælles midtlinje</SimpleValue>
         </Value>
         <Value ColumnRef="virkningFra">
            <SimpleValue>2027-02-01</SimpleValue>
         </Value>
         <Value ColumnRef="virkningTil"/>
      </Row>
      <Row>
         <Value ColumnRef="kode">
            <SimpleValue>Vej i eget tracé</SimpleValue>
         </Value>
         <Value ColumnRef="navn">
            <SimpleValue>Vej i eget tracé</SimpleValue>
         </Value>
         <Value ColumnRef="definition">
            <SimpleValue>veje med ensrettet færdsel, der har deres eget selvstændige forløb. F.eks. til- og frakørselsramper, ensrettede gader i byer</SimpleValue>
         </Value>
         <Value ColumnRef="kommentar"/>
         <Value ColumnRef="virkningFra">
            <SimpleValue>2027-02-01</SimpleValue>
         </Value>
         <Value ColumnRef="virkningTil"/>
      </Row>
      <Row>
         <Value ColumnRef="kode">
            <SimpleValue>Vej i parallelt tracé</SimpleValue>
         </Value>
         <Value ColumnRef="navn">
            <SimpleValue>Vej i parallelt tracé</SimpleValue>
         </Value>
         <Value ColumnRef="definition">
            <SimpleValue>veje med ensrettet færdsel og parallelle forløb, hvor kørebanerne er fysisk adskilt af f.eks. midterhelle, midterrabat eller autoværn</SimpleValue>
         </Value>
         <Value ColumnRef="kommentar">
            <SimpleValue>anvendes ved motorveje, motortrafikveje, kanaliseringsanlæg samt boulevarder</SimpleValue>
         </Value>
         <Value ColumnRef="virkningFra">
            <SimpleValue>2027-02-01</SimpleValue>
         </Value>
         <Value ColumnRef="virkningTil"/>
      </Row>
      <Row>
         <Value ColumnRef="kode">
            <SimpleValue>Sti i eget tracé</SimpleValue>
         </Value>
         <Value ColumnRef="navn">
            <SimpleValue>Sti i eget tracé</SimpleValue>
         </Value>
         <Value ColumnRef="definition">
            <SimpleValue>fritliggende sti med eget selvstændigt forløb, som ikke følger en vej. F.eks. stier gennem en skov, en sti gennem en park eller en sti mellem to boligområder i åbent landskab</SimpleValue>
         </Value>
         <Value ColumnRef="kommentar"/>
         <Value ColumnRef="virkningFra">
            <SimpleValue>2027-02-01</SimpleValue>
         </Value>
         <Value ColumnRef="virkningTil"/>
      </Row>
      <Row>
         <Value ColumnRef="kode">
            <SimpleValue>Sti langs vej</SimpleValue>
         </Value>
         <Value ColumnRef="navn">
            <SimpleValue>Sti langs vej</SimpleValue>
         </Value>
         <Value ColumnRef="definition">
            <SimpleValue>stier, der løber langs en vej og følger dennes forløb (tracé). Kan være adskilt af kantsten, rabat eller lignende, og kan anvendes på både stier og baner</SimpleValue>
         </Value>
         <Value ColumnRef="kommentar">
            <SimpleValue>har ofte samme vejkode som vejen den forløber langs</SimpleValue>
         </Value>
         <Value ColumnRef="virkningFra">
            <SimpleValue>2027-02-01</SimpleValue>
         </Value>
         <Value ColumnRef="virkningTil"/>
      </Row>
      <Row>
         <Value ColumnRef="kode">
            <SimpleValue>Ikke tildelt</SimpleValue>
         </Value>
         <Value ColumnRef="navn">
            <SimpleValue>Ikke tildelt</SimpleValue>
         </Value>
         <Value ColumnRef="definition">
            <SimpleValue>tildelingen mangler</SimpleValue>
         </Value>
         <Value ColumnRef="kommentar"/>
         <Value ColumnRef="virkningFra">
            <SimpleValue>2027-02-01</SimpleValue>
         </Value>
         <Value ColumnRef="virkningTil"/>
      </Row>
      <Row>
         <Value ColumnRef="kode">
            <SimpleValue>Ukendt</SimpleValue>
         </Value>
         <Value ColumnRef="navn">
            <SimpleValue>Ukendt</SimpleValue>
         </Value>
         <Value ColumnRef="definition">
            <SimpleValue>type kendes ikke</SimpleValue>
         </Value>
         <Value ColumnRef="kommentar"/>
         <Value ColumnRef="virkningFra">
            <SimpleValue>2027-02-01</SimpleValue>
         </Value>
         <Value ColumnRef="virkningTil"/>
      </Row>
   </SimpleCodeList>
</gc:CodeList>