   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/placering/Overflade">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/placering"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/placering"/>
      <skos:notation>Befæstet</skos:notation>
      <skos:prefLabel xml:lang="da">Overflade</skos:prefLabel>
      <skos:definition xml:lang="da">ligger på jordoverfladen eller på taget af en bygning</skos:definition>
      <dcterms:valid>2027-02-01/..</dcterms:valid>
   </skos:Concept>
   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/placering/P-kælder">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/placering"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/placering"/>
      <skos:notation>Ubefæstet</skos:notation>
      <skos:prefLabel xml:lang="da">P-kælder</skos:prefLabel>
      <skos:definition xml:lang="da">ligger i en kælder under jorden, men ikke under en bygning</skos:definition>
      <dcterms:valid>2027-02-01/..</dcterms:valid>
   </skos:Concept>
   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/placering/P-hus">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/placering"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/placering"/>
      <skos:notation>Ikke tildelt</skos:notation>
      <skos:prefLabel xml:lang="da">P-hus</skos:prefLabel>
      <skos:definition xml:lang="da">ligger inde i eller under en bygning</skos:definition>
      <dcterms:valid>2027-02-01/..</dcterms:valid>
   </skos:Concept>
