   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/banetype/Start_Landing">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/banetype"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/banetype"/>
      <skos:notation>Start_Landing</skos:notation>
      <skos:prefLabel xml:lang="da">Start_Landing</skos:prefLabel>
      <skos:definition xml:lang="da">lufthavnsområde hvorpå fly lander eller hvorfra fly starter</skos:definition>
      <dcterms:valid>2027-02-01/..</dcterms:valid>
   </skos:Concept>
   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/banetype/Taxivej">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/banetype"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/banetype"/>
      <skos:notation>Taxivej</skos:notation>
      <skos:prefLabel xml:lang="da">Taxivej</skos:prefLabel>
      <skos:definition xml:lang="da">lufthavnsområde der fortrinsvis bruges som veje for fly</skos:definition>
      <dcterms:valid>2027-02-01/..</dcterms:valid>
   </skos:Concept>
   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/banetype/Plads">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/banetype"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/banetype"/>
      <skos:notation>Plads</skos:notation>
      <skos:prefLabel xml:lang="da">Plads</skos:prefLabel>
      <skos:definition xml:lang="da">lufthavnsområde hvor fly optagter/afsætter passagerer eller gods, flyparkeringsområde samt flyserviceområde af enhver art</skos:definition>
      <dcterms:valid>2027-02-01/..</dcterms:valid>
   </skos:Concept>
   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/banetype/Helipad">
