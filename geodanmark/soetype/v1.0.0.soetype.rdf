      <skos:definition xml:lang="da">naturlig eller anlagt sø</skos:definition>
      <dcterms:valid>2027-02-01/..</dcterms:valid>
   </skos:Concept>
   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/soetype/Regnvandsbassin">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/soetype"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/soetype"/>
      <skos:notation>Regnvandsbassin</skos:notation>
      <skos:prefLabel xml:lang="da">Regnvandsbassin</skos:prefLabel>
      <skos:definition xml:lang="da">anlæg til opsamling af overskydende overfladevand under kraftige regnskyl for at minimere risiko for oversvømmelse</skos:definition>
      <dcterms:valid>2027-02-01/..</dcterms:valid>
   </skos:Concept>
