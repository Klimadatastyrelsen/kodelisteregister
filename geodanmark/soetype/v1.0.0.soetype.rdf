   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/soetype/Fiskedam">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/soetype"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/soetype"/>
      <skos:notation>Fiskedam</skos:notation>
      <skos:prefLabel xml:lang="da">Fiskedam</skos:prefLabel>
      <skos:definition xml:lang="da">bassin eller kunstig dam til opdræt af ferskvandsfisk i forbindelse med dambrug</skos:definition>
      <dcterms:valid>2027-02-01/..</dcterms:valid>
   </skos:Concept>
