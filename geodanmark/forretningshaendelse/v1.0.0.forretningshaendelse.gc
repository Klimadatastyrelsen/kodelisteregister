   <SimpleCodeList>
      <Row>
         <Value ColumnRef="kode">
            <SimpleValue>Nyt objekt</SimpleValue>
         </Value>
         <Value ColumnRef="navn">
            <SimpleValue>Nyt objekt</SimpleValue>
         </Value>
         <Value ColumnRef="definition">
            <SimpleValue>der er opstået et objekt med en ny ident</SimpleValue>
         </Value>
         <Value ColumnRef="kommentar">
            <SimpleValue>objektet er nyt. Der kan godt have været et andet objekt af samme type omtrent samme sted, men dette er blevet slettet</SimpleValue>
         </Value>
         <Value ColumnRef="virkningFra">
            <SimpleValue>2027-02-01</SimpleValue>
         </Value>
         <Value ColumnRef="virkningTil"/>
      </Row>
      <Row>
         <Value ColumnRef="kode">
            <SimpleValue>Ændret geometri</SimpleValue>
         </Value>
         <Value ColumnRef="navn">
            <SimpleValue>Ændret geometri</SimpleValue>
         </Value>
         <Value ColumnRef="definition">
            <SimpleValue>et eksisterende objekt har beholdt sin ident, men har fået ændret på geometrien</SimpleValue>
         </Value>
         <Value ColumnRef="kommentar">
            <SimpleValue>et eksisterende objekt har fået ændret hele eller dele af sin geometri. Den geometriske rettelse omhandler måske kun Z. 'id.lokalId' for objektet er uændret</SimpleValue>
         </Value>
         <Value ColumnRef="virkningFra">
            <SimpleValue>2027-02-01</SimpleValue>
         </Value>
         <Value ColumnRef="virkningTil"/>
      </Row>
      <Row>
         <Value ColumnRef="kode">
            <SimpleValue>Ændret attribut</SimpleValue>
         </Value>
         <Value ColumnRef="navn">
            <SimpleValue>Ændret attribut</SimpleValue>
         </Value>
         <Value ColumnRef="definition">
            <SimpleValue>et eksisterende objekt har beholdt sin ident, men har fået ændret på en eller flere af sine attributværdier</SimpleValue>
         </Value>
         <Value ColumnRef="kommentar">
            <SimpleValue>et eksisterende objekt har fået ændret en eller flere attributværdier. 'id.lokalId' for objektet er uændret</SimpleValue>
         </Value>
         <Value ColumnRef="virkningFra">
            <SimpleValue>2027-02-01</SimpleValue>
         </Value>
         <Value ColumnRef="virkningTil"/>
      </Row>
      <Row>
         <Value ColumnRef="kode">
            <SimpleValue>Ændret geometri og attribut</SimpleValue>
         </Value>
         <Value ColumnRef="navn">
            <SimpleValue>Ændret geometri og attribut</SimpleValue>
         </Value>
         <Value ColumnRef="definition">
            <SimpleValue>et eksisterende objekt har beholdt sin ident, men har fået ændret på geometrien og en eller flere af sine attributværdier</SimpleValue>
         </Value>
         <Value ColumnRef="kommentar"/>
         <Value ColumnRef="virkningFra">
            <SimpleValue>2027-02-01</SimpleValue>
         </Value>
         <Value ColumnRef="virkningTil"/>
      </Row>
      <Row>
         <Value ColumnRef="kode">
            <SimpleValue>Nedlagt objekt</SimpleValue>
         </Value>
         <Value ColumnRef="navn">
            <SimpleValue>Nedlagt objekt</SimpleValue>
         </Value>
         <Value ColumnRef="definition">
            <SimpleValue>objektet er gjort historisk</SimpleValue>
         </Value>
         <Value ColumnRef="kommentar">
            <SimpleValue>objektet er logisk slettet</SimpleValue>
         </Value>
         <Value ColumnRef="virkningFra">
            <SimpleValue>2027-02-01</SimpleValue>
         </Value>
         <Value ColumnRef="virkningTil"/>
      </Row>
   </SimpleCodeList>
