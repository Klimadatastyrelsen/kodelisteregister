   <SimpleCodeList>
      <Row>
         <Value ColumnRef="kode">
            <SimpleValue>Kørevej</SimpleValue>
         </Value>
         <Value ColumnRef="navn">
            <SimpleValue>Kørevej</SimpleValue>
         </Value>
         <Value ColumnRef="definition">
            <SimpleValue>færdselsareal på vej, bro, sti eller plads som skønnes at være åben for almindelig færdsel samt adgangsvej til mere end én ejendom</SimpleValue>
         </Value>
         <Value ColumnRef="kommentar"/>
         <Value ColumnRef="virkningFra">
            <SimpleValue>2027-02-01</SimpleValue>
         </Value>
         <Value ColumnRef="virkningTil"/>
      </Row>
      <Row>
         <Value ColumnRef="kode">
            <SimpleValue>Adgangsvej</SimpleValue>
         </Value>
         <Value ColumnRef="navn">
            <SimpleValue>Adgangsvej</SimpleValue>
         </Value>
         <Value ColumnRef="definition">
            <SimpleValue>kanten af en vej, der er adgangsvej til en enkelt ejendom og dermed forbinder ejendommen med den vej, hvortil dens adresse hører</SimpleValue>
         </Value>
         <Value ColumnRef="kommentar"/>
         <Value ColumnRef="virkningFra">
            <SimpleValue>2027-02-01</SimpleValue>
         </Value>
         <Value ColumnRef="virkningTil"/>
      </Row>
      <Row>
         <Value ColumnRef="kode">
            <SimpleValue>Parkering</SimpleValue>
         </Value>
         <Value ColumnRef="navn">
            <SimpleValue>Parkering</SimpleValue>
         </Value>
         <Value ColumnRef="definition">
            <SimpleValue>kant af selvstændigt parkeringsområde
Parkering i tilknytning til større enhed: institution, indkøbscenter, idrætsanlæg, jernbanestation, seværdighed eller lignende
Parkeringsområde i forbindelse med boligblok, rækkehuse samt på torv, i bycenter og på taget af en bygning</SimpleValue>
         </Value>
         <Value ColumnRef="kommentar"/>
         <Value ColumnRef="virkningFra">
            <SimpleValue>2027-02-01</SimpleValue>
         </Value>
         <Value ColumnRef="virkningTil"/>
      </Row>
      <Row>
         <Value ColumnRef="kode">
            <SimpleValue>Internvej</SimpleValue>
         </Value>
         <Value ColumnRef="navn">
            <SimpleValue>Internvej</SimpleValue>
         </Value>
         <Value ColumnRef="definition">
            <SimpleValue>internt færdselsareal ved boligblok, institution, industrigrund, lufthavn, kirkegård og lignende. Men ikke færdselsareal på parcelhusgrund
 </SimpleValue>
         </Value>
         <Value ColumnRef="kommentar"/>
         <Value ColumnRef="virkningFra">
            <SimpleValue>2027-02-01</SimpleValue>
         </Value>
         <Value ColumnRef="virkningTil"/>
      </Row>
      <Row>
         <Value ColumnRef="kode">
            <SimpleValue>Anden vej</SimpleValue>
         </Value>
         <Value ColumnRef="navn">
            <SimpleValue>Anden vej</SimpleValue>
         </Value>
         <Value ColumnRef="definition">
            <SimpleValue>kant af små veje med lille betydning.
Ofte korte og blinde veje, der betjener bagsiden af bygninger, baggårde, interne parkeringsarealer og lignende</SimpleValue>
         </Value>
         <Value ColumnRef="kommentar"/>
         <Value ColumnRef="virkningFra">
            <SimpleValue>2027-02-01</SimpleValue>
         </Value>
         <Value ColumnRef="virkningTil"/>
      </Row>
      <Row>
         <Value ColumnRef="kode">
            <SimpleValue>Supplerende Vejkant</SimpleValue>
         </Value>
         <Value ColumnRef="navn">
            <SimpleValue>Supplerende Vejkant</SimpleValue>
         </Value>
         <Value ColumnRef="definition">
            <SimpleValue>supplerende linjer uden for færdselsarealet i forbindelse med buslomme eller rundkørsel samt ved vende- og parkeringsareal langs vej</SimpleValue>
         </Value>
         <Value ColumnRef="kommentar">
            <SimpleValue>Registreres ikke fotogrammetrisk, da kommunen selv skal registrere disse.   Registreres kun administrativt.</SimpleValue>
         </Value>
         <Value ColumnRef="virkningFra">
            <SimpleValue>2027-02-01</SimpleValue>
         </Value>
         <Value ColumnRef="virkningTil"/>
      </Row>
      <Row>
         <Value ColumnRef="kode">
            <SimpleValue>Helle</SimpleValue>
         </Value>
         <Value ColumnRef="navn">
            <SimpleValue>Helle</SimpleValue>
         </Value>
         <Value ColumnRef="definition">
            <SimpleValue>omrids af helleanlæg i forbindelse med kryds, svingbaner og fodgængerovergang
Helle har kørende 4-hjulet trafik på begge sider. Hvis der på den ene side af et trafik-skille-område kun forekommer 2-hjulet trafik, er området ikke Helle med Chikane</SimpleValue>
         </Value>
         <Value ColumnRef="kommentar"/>
         <Value ColumnRef="virkningFra">
            <SimpleValue>2027-02-01</SimpleValue>
         </Value>
         <Value ColumnRef="virkningTil"/>
      </Row>
      <Row>
         <Value ColumnRef="kode">
            <SimpleValue>Cykelsti langs vej</SimpleValue>
         </Value>
         <Value ColumnRef="navn">
            <SimpleValue>Cykelsti langs vej</SimpleValue>
         </Value>
         <Value ColumnRef="definition">
            <SimpleValue>kant af færdselsareal primært til brug for cykler. Færdselsarealet grænser op til Kørevej/Internvej eller en rabat langs kørebanen. Sti kun for cyklende og langsomt kørende motoriseret to-/trehjulet trafik
 </SimpleValue>
         </Value>
         <Value ColumnRef="kommentar"/>
         <Value ColumnRef="virkningFra">
            <SimpleValue>2027-02-01</SimpleValue>
         </Value>
         <Value ColumnRef="virkningTil"/>
      </Row>
      <Row>
         <Value ColumnRef="kode">
            <SimpleValue>Gennemgående sti</SimpleValue>
         </Value>
         <Value ColumnRef="navn">
            <SimpleValue>Gennemgående sti</SimpleValue>
         </Value>
         <Value ColumnRef="definition">
            <SimpleValue>kant af færdselsareal i form af gennemgående sti i eget tracé, herunder overordnet sti, der tjener til fordelingsnet for mindre sidestier</SimpleValue>
         </Value>
         <Value ColumnRef="kommentar"/>
         <Value ColumnRef="virkningFra">
            <SimpleValue>2027-02-01</SimpleValue>
         </Value>
         <Value ColumnRef="virkningTil"/>
      </Row>
      <Row>
         <Value ColumnRef="kode">
            <SimpleValue>Lokal sti</SimpleValue>
         </Value>
         <Value ColumnRef="navn">
            <SimpleValue>Lokal sti</SimpleValue>
         </Value>
         <Value ColumnRef="definition">
            <SimpleValue>intern eller mindre sti</SimpleValue>
         </Value>
         <Value ColumnRef="kommentar"/>
         <Value ColumnRef="virkningFra">
            <SimpleValue>2027-02-01</SimpleValue>
         </Value>
         <Value ColumnRef="virkningTil"/>
      </Row>
      <Row>
         <Value ColumnRef="kode">
            <SimpleValue>Ikke tildelt</SimpleValue>
         </Value>
         <Value ColumnRef="navn">
            <SimpleValue>Ikke tildelt</SimpleValue>
         </Value>
         <Value ColumnRef="definition">
            <SimpleValue>typen af Vejkant er ikke tildelt</SimpleValue>
         </Value>
         <Value ColumnRef="kommentar"/>
         <Value ColumnRef="virkningFra">
            <SimpleValue>2027-02-01</SimpleValue>
         </Value>
         <Value ColumnRef="virkningTil"/>
      </Row>
      <Row>
         <Value ColumnRef="kode">
            <SimpleValue>Ukendt</SimpleValue>
         </Value>
         <Value ColumnRef="navn">
            <SimpleValue>Ukendt</SimpleValue>
         </Value>
         <Value ColumnRef="definition">
            <SimpleValue>typen af Vejkant er ikke kendt</SimpleValue>
         </Value>
         <Value ColumnRef="kommentar"/>
         <Value ColumnRef="virkningFra">
            <SimpleValue>2027-02-01</SimpleValue>
         </Value>
         <Value ColumnRef="virkningTil"/>
      </Row>
   </SimpleCodeList>
