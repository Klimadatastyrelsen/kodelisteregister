   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/Motorvej">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark"/>
      <skos:notation>Motorvej</skos:notation>
      <skos:prefLabel xml:lang="da">Motorvej</skos:prefLabel>
      <skos:definition xml:lang="da">veje, der er anlagt efter reglerne for motorvej</skos:definition>
      <dcterms:valid>2027-02-01/..</dcterms:valid>
   </skos:Concept>
   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/Motortrafikvej">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark"/>
      <skos:notation>Motortrafikvej</skos:notation>
      <skos:prefLabel xml:lang="da">Motortrafikvej</skos:prefLabel>
      <skos:definition xml:lang="da">veje, der er anlagt efter reglerne for motortrafikvej
 </skos:definition>
      <dcterms:valid>2027-02-01/..</dcterms:valid>
   </skos:Concept>
   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/Gennemfartsvej">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark"/>
      <skos:notation>Gennemfartsvej</skos:notation>
      <skos:prefLabel xml:lang="da">Gennemfartsvej</skos:prefLabel>
      <skos:definition xml:lang="da">veje, der betjener den overordnede trafik mellem landsdelene samt mellem større bysamfund og større bydele
 </skos:definition>
      <dcterms:valid>2027-02-01/..</dcterms:valid>
   </skos:Concept>
   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/Fordelingsvej">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark"/>
      <skos:notation>Fordelingsvej</skos:notation>
      <skos:prefLabel xml:lang="da">Fordelingsvej</skos:prefLabel>
      <skos:definition xml:lang="da">veje, der betjener den overordnede trafik mellem større bysamfund og større bydele og er bindeleddet mellem de større rutenetværk og de mere lokale veje
 </skos:definition>
      <dcterms:valid>2027-02-01/..</dcterms:valid>
   </skos:Concept>
   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/Stor vej">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark"/>
      <skos:notation>Stor vej</skos:notation>
      <skos:prefLabel xml:lang="da">Stor vej</skos:prefLabel>
      <skos:definition xml:lang="da">store lokale veje i byer og større veje på landet med store trafikmængder og tung trafik i forhold til andre veje i området</skos:definition>
      <rdfs:comment xml:lang="da">disse veje indgår ikke i Vejdirektoratets rutenetværk</rdfs:comment>
      <dcterms:valid>2027-02-01/..</dcterms:valid>
   </skos:Concept>
   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/Mellem vej">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark"/>
      <skos:notation>Mellem vej</skos:notation>
      <skos:prefLabel xml:lang="da">Mellem vej</skos:prefLabel>
      <skos:definition xml:lang="da">lokale veje til mindre trafikmængder i forhold til andre veje i område</skos:definition>
      <rdfs:comment xml:lang="da">disse veje indgår ikke i Vejdirektoratets rutenetværk</rdfs:comment>
      <dcterms:valid>2027-02-01/..</dcterms:valid>
   </skos:Concept>
   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/Lille vej">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark"/>
      <skos:notation>Lille vej</skos:notation>
      <skos:prefLabel xml:lang="da">Lille vej</skos:prefLabel>
      <skos:definition xml:lang="da">mindre lokalveje, boligveje og større lukkede veje.
Desuden større skovveje, der kan bære tung trafik</skos:definition>
      <rdfs:comment xml:lang="da">disse veje indgår ikke i Vejdirektoratets rutenetværk</rdfs:comment>
      <dcterms:valid>2027-02-01/..</dcterms:valid>
   </skos:Concept>
   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/Adgangsvej">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark"/>
      <skos:notation>Adgangsvej</skos:notation>
      <skos:prefLabel xml:lang="da">Adgangsvej</skos:prefLabel>
      <skos:definition xml:lang="da">som hovedregel blinde og/eller sparsomt trafikerede veje der kun er adgangsgivende til meget få adresser og/eller ejendomme</skos:definition>
      <rdfs:comment xml:lang="da">på landet (dvs. uden for Områdepolygon): Indkørselsveje til enligt beliggende ejendomme beliggende på sideveje afgrenet fra veje, der ofte er større.   I byer (dvs. inden for Områdepolygon): Korte og oftest blinde veje som adgang til få ejendomme og vej for adgang til en boligblok på langs af blokken eller til dens parkeringsplads</rdfs:comment>
      <dcterms:valid>2027-02-01/..</dcterms:valid>
   </skos:Concept>
   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/Anden vej">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark"/>
      <skos:notation>Anden vej</skos:notation>
      <skos:prefLabel xml:lang="da">Anden vej</skos:prefLabel>
      <skos:definition xml:lang="da">små veje med lille betydning f.eks små markveje, skovveje, blinde veje</skos:definition>
      <dcterms:valid>2027-02-01/..</dcterms:valid>
   </skos:Concept>
   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/Parkering">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark"/>
      <skos:notation>Parkering</skos:notation>
      <skos:prefLabel xml:lang="da">Parkering</skos:prefLabel>
      <skos:definition xml:lang="da">Små ikke-gennemgående veje på parkerings- og rastepladser.</skos:definition>
      <dcterms:valid>2027-02-01/..</dcterms:valid>
   </skos:Concept>
   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/Gennemgående sti">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark"/>
      <skos:notation>Gennemgående sti</skos:notation>
      <skos:prefLabel xml:lang="da">Gennemgående sti</skos:prefLabel>
      <skos:definition xml:lang="da">gennemgående sti i eget tracé (anlagt sti eller sti med belysning), der forløber uafhængigt af en Vejmidte-Vej eller, hvor den langs en vej ligger i eget trace adskilt fra kørebanen med en bred rabat, et hegn, en grøft eller et andet fysisk objekt</skos:definition>
      <dcterms:valid>2027-02-01/..</dcterms:valid>
   </skos:Concept>
   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/Lokal sti">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark"/>
      <skos:notation>Lokal sti</skos:notation>
      <skos:prefLabel xml:lang="da">Lokal sti</skos:prefLabel>
      <skos:definition xml:lang="da">lille sti, ofte en intern sti (anlagt sti eller sti med belysning) i grønt område, park og indgang fra vej til bygning registreres</skos:definition>
      <dcterms:valid>2027-02-01/..</dcterms:valid>
   </skos:Concept>
   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/Cykelsti langs vej">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark"/>
      <skos:notation>Cykelsti langs vej</skos:notation>
      <skos:prefLabel xml:lang="da">Cykelsti langs vej</skos:prefLabel>
      <skos:definition xml:lang="da">sti, der forløber langs en vej kun adskilt fra kørebanen med en kantsten eller en rabat. Kun for cyklende trafik</skos:definition>
      <dcterms:valid>2027-02-01/..</dcterms:valid>
   </skos:Concept>
   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/Cykelbane langs vej">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark"/>
      <skos:notation>Cykelbane langs vej</skos:notation>
      <skos:prefLabel xml:lang="da">Cykelbane langs vej</skos:prefLabel>
      <skos:definition xml:lang="da">sti, det forløber langs en vej kun adskilt fra kørebanen med en (mindst 30 cm.) bred bemaling og med cykelsymboler. Kun for cyklende trafik</skos:definition>
      <rdfs:comment xml:lang="da">cykelbanen har normalt samme 'kommunekode' og 'vejkode' som den vej, den løber langs</rdfs:comment>
      <dcterms:valid>2027-02-01/..</dcterms:valid>
   </skos:Concept>
   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/Bred kantbane">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark"/>
      <skos:notation>Bred kantbane</skos:notation>
      <skos:prefLabel xml:lang="da">Bred kantbane</skos:prefLabel>
      <skos:definition xml:lang="da">sti, det forløber langs en vej kun adskilt fra kørebanen med en bemaling men uden cykelsymboler. Kun for cyklende trafik. 
 
 </skos:definition>
      <rdfs:comment xml:lang="da">cykelbanen har normalt samme 'kommunekode' og 'vejkode' som den vej, den løber langs. Stibredden er mindre end for ”Cykelbane langs vej”. Etableres og ajourføres udelukkende administrativt</rdfs:comment>
      <dcterms:valid>2027-02-01/..</dcterms:valid>
   </skos:Concept>
   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/Fiktiv">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark"/>
      <skos:notation>Fiktiv</skos:notation>
      <skos:prefLabel xml:lang="da">Fiktiv</skos:prefLabel>
      <skos:definition xml:lang="da">vej eller plads, der ikke findes fysisk f.eks ruten som ”Sandormen” på Grenen kører</skos:definition>
      <dcterms:valid>2027-02-01/..</dcterms:valid>
   </skos:Concept>
</rdf:RDF>