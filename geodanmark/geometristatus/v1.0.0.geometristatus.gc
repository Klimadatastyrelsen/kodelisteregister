      </Column>
      <Column Id="navn"
              Use="required">
         <Annotation>
            <Description>
               <dcterms:description>foretrukne term for koden</dcterms:description>
            </Description>
         </Annotation>
         <ShortName>navn</ShortName>
         <Data Type="string"
               Lang="da"/>
      </Column>
      <Column Id="definition"
              Use="optional">
         <Annotation>
            <Description>
               <dcterms:description>kort beskrivelse eller formel forklaring af kodens betydning</dcterms:description>
            </Description>
         </Annotation>
         <ShortName>definition</ShortName>
         <Data Type="string"
               Lang="da"/>
      </Column>
      <Column Id="kommentar"
              Use="optional">
         <Annotation>
            <Description>
               <dcterms:description>kommentar som hjælper til afklaring af forståelse af koden</dcterms:description>
            </Description>
         </Annotation>
         <ShortName>kommentar</ShortName>
         <Data Type="string"
               Lang="da"/>
      </Column>
      <Column Id="virkningFra"
              Use="required">
         <Annotation>
            <Description>
               <dcterms:description>tidspunkt for hvornår koden må tages i anvendelse for nye registreringer</dcterms:description>
            </Description>
         </Annotation>
         <ShortName>virkningFra</ShortName>
         <Data Type="date"/>
      </Column>
      <Column Id="virkningTil"
              Use="optional">
         <Annotation>
            <Description>
               <dcterms:description>tidspunkt for hvornår koden ikke længere må anvendes i nye registreringer. Koden kan eksistere i data, der er registreret før dette tidspunkt</dcterms:description>
            </Description>
         </Annotation>
         <ShortName>virkningTil</ShortName>
         <Data Type="date"/>
      </Column>
      <Key Id="key_code">
         <ShortName>key_code</ShortName>
         <ColumnRef Ref="kode"/>
      </Key>
      <Key Id="key_navn">
         <ShortName>key_navn</ShortName>
         <ColumnRef Ref="navn"/>
      </Key>
   </ColumnSet>
   <SimpleCodeList>
      <Row>
         <Value ColumnRef="kode">
            <SimpleValue>Endelig</SimpleValue>
         </Value>
         <Value ColumnRef="navn">
            <SimpleValue>Endelig</SimpleValue>
         </Value>
         <Value ColumnRef="definition">
            <SimpleValue>geometrien er endelig og fuldt tilfredsstillende fastlagt</SimpleValue>
         </Value>
         <Value ColumnRef="kommentar">
            <SimpleValue>med denne værdi signaleres, at datas geometriske kvalitet er fuldt tilfredsstillende i forhold til den angivne etableringsmetode og at geometrien er endeligt fastlagt. Der er således ikke tale om registrering af planlagte forhold i terrænet. Alene forhold, der allerede findes i terrænet og er endeligt stedbestemt i plan og højde, må kaldes ”Endelig”. Ved landmåling (inkl. kote) eller ved fotogrammetri skal denne værdi altid anvendes</SimpleValue>
         </Value>
         <Value ColumnRef="virkningFra">
            <SimpleValue>2027-02-01</SimpleValue>
         </Value>
         <Value ColumnRef="virkningTil"/>
      </Row>
      <Row>
         <Value ColumnRef="kode">
            <SimpleValue>Foreløbig</SimpleValue>
         </Value>
         <Value ColumnRef="navn">
            <SimpleValue>Foreløbig</SimpleValue>
         </Value>
         <Value ColumnRef="definition">
            <SimpleValue>geometrien er foreløbig og ikke tilfredsstillende fastlagt</SimpleValue>
         </Value>
         <Value ColumnRef="kommentar">
            <SimpleValue>værdien "Foreløbig" betyder, at objektets geometri ikke er endeligt fastlagt endnu. Disse foreløbige geometrier kan automatisk udpeges til at blive endeligt opmålt eller verificeret i forbindelse med førstkommende ajourføring ved landmåling eller fotogrammetri. Hvor det indlagte objekt enten er: planlagt / projekttegninger, digitaliseret ud fra ortofoto, under etablering, uden en valid Z-koordinat skal dets geometri derfor indmeldes som ”Foreløbig”</SimpleValue>
         </Value>
         <Value ColumnRef="virkningFra">
            <SimpleValue>2027-02-01</SimpleValue>
         </Value>
         <Value ColumnRef="virkningTil"/>
      </Row>
   </SimpleCodeList>
</gc:CodeList>