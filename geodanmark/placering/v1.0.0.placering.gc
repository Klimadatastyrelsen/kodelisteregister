         <dcterms:available>2026-11-24</dcterms:available>
      </Description>
   </Annotation>
   <Identification>
      <ShortName>placering</ShortName>
      <Version>1.0.0</Version>
      <CanonicalUri>urn:uuid:aa3547dc-7568-435c-8466-e3ee915dcacc</CanonicalUri>
      <CanonicalVersionUri>urn:uuid:6c20b389-a301-406f-a122-02f93cb9e259</CanonicalVersionUri>
      <LocationUri>https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/placering/v1.0.0.placering.gc</LocationUri>
      <AlternateFormatLocationUri MimeType="text/csv">https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/placering/v1.0.0.placering.csv</AlternateFormatLocationUri>
      <AlternateFormatLocationUri MimeType="text/html">https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/placering/v1.0.0.placering.html</AlternateFormatLocationUri>
      <AlternateFormatLocationUri MimeType="application/rdf+xml">https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/placering/v1.0.0.placering.rdf</AlternateFormatLocationUri>
      <Agency>
         <LongName>GeoDanmark</LongName>
      </Agency>
   </Identification>
   <ColumnSet>
      <Column Id="kode"
              Use="required">
         <Annotation>
            <Description>
               <dcterms:description>tilladt værdi i data</dcterms:description>
            </Description>
         </Annotation>
         <ShortName>kode</ShortName>
         <Data Type="string"/>
      </Column>
      <Column Id="navn"
              Use="required">
         <Annotation>
            <Description>
               <dcterms:description>foretrukne term for koden</dcterms:description>
            </Description>
         </Annotation>
         <ShortName>navn</ShortName>
         <Data Type="string"
               Lang="da"/>
      </Column>
      <Column Id="definition"
              Use="optional">
         <Annotation>
            <Description>
               <dcterms:description>kort beskrivelse eller formel forklaring af kodens betydning</dcterms:description>
            </Description>
         </Annotation>
         <ShortName>definition</ShortName>
         <Data Type="string"
               Lang="da"/>
      </Column>
      <Column Id="kommentar"
              Use="optional">
         <Annotation>
            <Description>
               <dcterms:description>kommentar som hjælper til afklaring af forståelse af koden</dcterms:description>
            </Description>
         </Annotation>
         <ShortName>kommentar</ShortName>
         <Data Type="string"
               Lang="da"/>
      </Column>
      <Column Id="virkningFra"
              Use="required">
         <Annotation>
            <Description>
               <dcterms:description>tidspunkt for hvornår koden må tages i anvendelse for nye registreringer</dcterms:description>
            </Description>
         </Annotation>
         <ShortName>virkningFra</ShortName>
         <Data Type="date"/>
      </Column>
      <Column Id="virkningTil"
              Use="optional">
         <Annotation>
            <Description>
               <dcterms:description>tidspunkt for hvornår koden ikke længere må anvendes i nye registreringer. Koden kan eksistere i data, der er registreret før dette tidspunkt</dcterms:description>
            </Description>
         </Annotation>
         <ShortName>virkningTil</ShortName>
         <Data Type="date"/>
      </Column>
      <Key Id="key_code">
         <ShortName>key_code</ShortName>
         <ColumnRef Ref="kode"/>
      </Key>
      <Key Id="key_navn">
         <ShortName>key_navn</ShortName>
         <ColumnRef Ref="navn"/>
      </Key>
   </ColumnSet>
   <SimpleCodeList>
      <Row>
         <Value ColumnRef="kode">
            <SimpleValue>Befæstet</SimpleValue>
         </Value>
         <Value ColumnRef="navn">
            <SimpleValue>Overflade</SimpleValue>
         </Value>
         <Value ColumnRef="definition">
            <SimpleValue>ligger på jordoverfladen eller på taget af en bygning</SimpleValue>
         </Value>
         <Value ColumnRef="kommentar"/>
         <Value ColumnRef="virkningFra">
            <SimpleValue>2027-02-01</SimpleValue>
         </Value>
         <Value ColumnRef="virkningTil"/>
      </Row>
      <Row>
         <Value ColumnRef="kode">
            <SimpleValue>Ubefæstet</SimpleValue>
         </Value>
         <Value ColumnRef="navn">
            <SimpleValue>P-kælder</SimpleValue>
         </Value>
         <Value ColumnRef="definition">
            <SimpleValue>ligger i en kælder under jorden, men ikke under en bygning</SimpleValue>
         </Value>
         <Value ColumnRef="kommentar"/>
         <Value ColumnRef="virkningFra">
            <SimpleValue>2027-02-01</SimpleValue>
         </Value>
         <Value ColumnRef="virkningTil"/>
      </Row>
      <Row>
         <Value ColumnRef="kode">
            <SimpleValue>Ikke tildelt</SimpleValue>
         </Value>
         <Value ColumnRef="navn">
            <SimpleValue>P-hus</SimpleValue>
         </Value>
         <Value ColumnRef="definition">
            <SimpleValue>ligger inde i eller under en bygning</SimpleValue>
         </Value>
         <Value ColumnRef="kommentar"/>
         <Value ColumnRef="virkningFra">
            <SimpleValue>2027-02-01</SimpleValue>
         </Value>
         <Value ColumnRef="virkningTil"/>
      </Row>
   </SimpleCodeList>
</gc:CodeList>