      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/bassintype"/>
      <skos:notation>Ikke tildelt</skos:notation>
      <skos:prefLabel xml:lang="da">Ikke tildelt</skos:prefLabel>
      <skos:definition xml:lang="da">tildelingen mangler</skos:definition>
      <rdfs:comment xml:lang="da">bassintypen er ikke tildelt</rdfs:comment>
      <dcterms:valid>2027-02-01/..</dcterms:valid>
   </skos:Concept>
   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/bassintype/Ukendt">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/bassintype"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/bassintype"/>
      <skos:notation>Ukendt</skos:notation>
      <skos:prefLabel xml:lang="da">Ukendt</skos:prefLabel>
      <skos:definition xml:lang="da">type kendes ikke</skos:definition>
      <rdfs:comment xml:lang="da">bassintypen er ukendt</rdfs:comment>
      <dcterms:valid>2027-02-01/..</dcterms:valid>
   </skos:Concept>
   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/bassintype/Andet">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/bassintype"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/bassintype"/>
      <skos:notation>Andet</skos:notation>
      <skos:prefLabel xml:lang="da">Andet</skos:prefLabel>
      <skos:definition xml:lang="da">værdi ikke omfattet af de øvrige mulige værdier</skos:definition>
      <rdfs:comment xml:lang="da">bassintypen er noget andet end de andre værdier</rdfs:comment>
