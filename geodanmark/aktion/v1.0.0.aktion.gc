         <dcterms:available>2026-11-24</dcterms:available>
      </Description>
   </Annotation>
   <Identification>
      <ShortName>aktion</ShortName>
      <Version>1.0.0</Version>
      <CanonicalUri>urn:uuid:a1797f97-9beb-483d-b6ed-da29376ce5c6</CanonicalUri>
      <CanonicalVersionUri>urn:uuid:f637af21-4844-42a1-889c-ff85903545a8</CanonicalVersionUri>
