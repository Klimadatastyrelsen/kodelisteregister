   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/Motorvej">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark"/>
      <skos:notation>Motorvej</skos:notation>
      <skos:prefLabel xml:lang="da">Motorvej</skos:prefLabel>
      <skos:definition xml:lang="da">veje, der er anlagt efter reglerne for motorvej</skos:definition>
      <dcterms:valid>2027-02-01/..</dcterms:valid>
   </skos:Concept>
   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/Motortrafikvej">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark"/>
      <skos:notation>Motortrafikvej</skos:notation>
      <skos:prefLabel xml:lang="da">Motortrafikvej</skos:prefLabel>
      <skos:definition xml:lang="da">veje, der er anlagt efter reglerne for motortrafikvej</skos:definition>
      <dcterms:valid>2027-02-01/..</dcterms:valid>
   </skos:Concept>
   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/Vej">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark"/>
      <skos:notation>Vej</skos:notation>
      <skos:prefLabel xml:lang="da">Vej</skos:prefLabel>
      <skos:definition xml:lang="da">øvrige veje hvis funktion IKKE kan gå ind under en af denne listes værdier</skos:definition>
      <dcterms:valid>2027-02-01/..</dcterms:valid>
   </skos:Concept>
   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/Rundkørsel">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark"/>
      <skos:notation>Rundkørsel</skos:notation>
      <skos:prefLabel xml:lang="da">Rundkørsel</skos:prefLabel>
      <skos:definition xml:lang="da">cirkulært køreareal i et vejkryds, hvor færdslen reguleres mod uret</skos:definition>
      <dcterms:valid>2027-02-01/..</dcterms:valid>
   </skos:Concept>
   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/Parkering">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark"/>
      <skos:notation>Parkering</skos:notation>
      <skos:prefLabel xml:lang="da">Parkering</skos:prefLabel>
      <skos:definition xml:lang="da">små ikke-gennemkørende veje på parkerings- og rastepladser</skos:definition>
      <dcterms:valid>2027-02-01/..</dcterms:valid>
   </skos:Concept>
   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/Frakørsel">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark"/>
      <skos:notation>Frakørsel</skos:notation>
      <skos:prefLabel xml:lang="da">Frakørsel</skos:prefLabel>
      <skos:definition xml:lang="da">ensrettet forbindelsesvej i eget tracé, der muliggør skift mellem veje ofte placeret i forskellige niveauer. Forløbet starter ved primærvejens udfletningspunkt (frakørsel) og afsluttes ved primærvejens sammenfletningspunkt (tilkørsel)</skos:definition>
      <dcterms:valid>2027-02-01/..</dcterms:valid>
   </skos:Concept>
   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/Tilkørsel">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark"/>
      <skos:notation>Tilkørsel</skos:notation>
      <skos:prefLabel xml:lang="da">Tilkørsel</skos:prefLabel>
      <skos:definition xml:lang="da">ensrettet forbindelsesvej i eget tracé, der muliggør skift mellem veje ofte placeret i forskellige niveauer. Forløbet starter ved tilslutning fra det øvrige vejnet og afsluttes ved primærvejens sammenfletningspunkt (tilkørsel)</skos:definition>
      <dcterms:valid>2027-02-01/..</dcterms:valid>
   </skos:Concept>
   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/Øvrige rampe">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark"/>
      <skos:notation>Øvrige rampe</skos:notation>
      <skos:prefLabel xml:lang="da">Øvrige rampe</skos:prefLabel>
      <skos:definition xml:lang="da">rampe med dobbeltrettet færdsel</skos:definition>
      <dcterms:valid>2027-02-01/..</dcterms:valid>
   </skos:Concept>
   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/Parallelspor">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark"/>
      <skos:notation>Parallelspor</skos:notation>
      <skos:prefLabel xml:lang="da">Parallelspor</skos:prefLabel>
      <skos:definition xml:lang="da">separat kørebane placeret umiddelbart uden for de normale kørebaner og parallelt med disse (typisk langs motorvej). Parallelsporet bruges til at adskille flettetrafik fra den gennemgående, og adgangen sker ofte via ind- og udfletning</skos:definition>
      <dcterms:valid>2027-02-01/..</dcterms:valid>
   </skos:Concept>
   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/Shunt">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark"/>
      <skos:notation>Shunt</skos:notation>
      <skos:prefLabel xml:lang="da">Shunt</skos:prefLabel>
      <skos:definition xml:lang="da">kort forbindelsesvej i eget tracé, der lader trafik svinge til højre uden at skulle ind i selve krydset eller rundkørslen. Shunts har altid ensrettet færdsel</skos:definition>
      <dcterms:valid>2027-02-01/..</dcterms:valid>
   </skos:Concept>
   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/Cykelsti">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark"/>
      <skos:notation>Cykelsti</skos:notation>
      <skos:prefLabel xml:lang="da">Cykelsti</skos:prefLabel>
      <skos:definition xml:lang="da">trafikken er kun for cyklende færdsel</skos:definition>
      <dcterms:valid>2027-02-01/..</dcterms:valid>
   </skos:Concept>
   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/Gangsti">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark"/>
      <skos:notation>Gangsti</skos:notation>
      <skos:prefLabel xml:lang="da">Gangsti</skos:prefLabel>
      <skos:definition xml:lang="da">trafikken er kun for gående færdsel</skos:definition>
      <dcterms:valid>2027-02-01/..</dcterms:valid>
   </skos:Concept>
   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/Fællessti">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark"/>
      <skos:notation>Fællessti</skos:notation>
      <skos:prefLabel xml:lang="da">Fællessti</skos:prefLabel>
      <skos:definition xml:lang="da">sti beregnet til både cyklister og fodgængere uden fysisk adskillelse mellem trafikarterne</skos:definition>
      <dcterms:valid>2027-02-01/..</dcterms:valid>
   </skos:Concept>
   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/Cykelbane">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark"/>
      <skos:notation>Cykelbane</skos:notation>
      <skos:prefLabel xml:lang="da">Cykelbane</skos:prefLabel>
      <skos:definition xml:lang="da">sti, der forløber langs en vej kun adskilt fra kørebanen med en (mindst 30 cm.) bred bemaling. Kun for cyklende trafik. Cykelbanen har normalt samme 'kommunekode' og 'vejkode' som den vej, den løber langs. Der er malet cykelsymboler på stiens asfalt langs stiens forløb</skos:definition>
      <dcterms:valid>2027-02-01/..</dcterms:valid>
   </skos:Concept>
   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/Rekreativ sti">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark"/>
      <skos:notation>Rekreativ sti</skos:notation>
      <skos:prefLabel xml:lang="da">Rekreativ sti</skos:prefLabel>
      <skos:definition xml:lang="da">sti som IKKE kan placeres under én af de andre værdier for sti. Det kunne for eksempel være ridestier.</skos:definition>
      <dcterms:valid>2027-02-01/..</dcterms:valid>
   </skos:Concept>
   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/Bred kantbane">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark"/>
      <skos:notation>Bred kantbane</skos:notation>
      <skos:prefLabel xml:lang="da">Bred kantbane</skos:prefLabel>
      <skos:definition xml:lang="da">sti, der forløber langs en vej kun adskilt fra kørebanen med en bemaling. Kun for cyklende trafik. Kantbanen har normalt samme 'kommunekode' og 'vejkode' som den vej, den løber langs. Der er ikke malet cykelsymboler på stiens asfalt langs stiens forløb og stibredden er mindre end for "Cykelbane"</skos:definition>
      <dcterms:valid>2027-02-01/..</dcterms:valid>
   </skos:Concept>
   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/Ikke tildelt">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark"/>
      <skos:notation>Ikke tildelt</skos:notation>
      <skos:prefLabel xml:lang="da">Ikke tildelt</skos:prefLabel>
      <skos:definition xml:lang="da">tildelingen mangler</skos:definition>
      <dcterms:valid>2027-02-01/..</dcterms:valid>
   </skos:Concept>
   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/Ukendt">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark"/>
      <skos:notation>Ukendt</skos:notation>
      <skos:prefLabel xml:lang="da">Ukendt</skos:prefLabel>
      <skos:definition xml:lang="da">type kendes ikke</skos:definition>
      <dcterms:valid>2027-02-01/..</dcterms:valid>
   </skos:Concept>
</rdf:RDF>