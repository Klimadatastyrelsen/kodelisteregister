   <SimpleCodeList>
      <Row>
         <Value ColumnRef="kode">
            <SimpleValue>A</SimpleValue>
         </Value>
         <Value ColumnRef="navn">
            <SimpleValue>Absolut placeret</SimpleValue>
         </Value>
         <Value ColumnRef="definition">
            <SimpleValue>adgangspunker og vejpunkter, der er placeret af adressemyndigheden.</SimpleValue>
         </Value>
         <Value ColumnRef="kommentar">
            <SimpleValue>Nøjagtighedsklasse for Vejpunkt/Adgangspunkt.</SimpleValue>
         </Value>
         <Value ColumnRef="virkningFra">
            <SimpleValue>2015-10-01</SimpleValue>
         </Value>
         <Value ColumnRef="virkningTil"/>
      </Row>
      <Row>
         <Value ColumnRef="kode">
            <SimpleValue>B</SimpleValue>
         </Value>
         <Value ColumnRef="navn">
            <SimpleValue>Beregnet placering</SimpleValue>
         </Value>
         <Value ColumnRef="definition">
            <SimpleValue>alle vejpunkter blev beregnet da DAR blev skabt. Hvis punktet ikke er rykket siden, vil nøjagtighedklassen være B</SimpleValue>
         </Value>
         <Value ColumnRef="kommentar">
            <SimpleValue>Nøjagtighedsklasse for Vejpunkt/Adgangspunkt.</SimpleValue>
         </Value>
         <Value ColumnRef="virkningFra">
            <SimpleValue>2015-10-01</SimpleValue>
         </Value>
         <Value ColumnRef="virkningTil"/>
      </Row>
      <Row>
         <Value ColumnRef="kode">
            <SimpleValue>A</SimpleValue>
         </Value>
         <Value ColumnRef="navn">
            <SimpleValue>Manuelt sat, følger IKKE GeoDanmark</SimpleValue>
         </Value>
         <Value ColumnRef="definition">
            <SimpleValue>navngivne veje, der ikke skal følge GeoDanmarks vejmidte</SimpleValue>
         </Value>
         <Value ColumnRef="kommentar">
            <SimpleValue>Nøjagtighedsklasse for Vejnavnebeliggenhed.</SimpleValue>
         </Value>
         <Value ColumnRef="virkningFra">
            <SimpleValue>2015-10-01</SimpleValue>
         </Value>
         <Value ColumnRef="virkningTil"/>
      </Row>
      <Row>
         <Value ColumnRef="kode">
            <SimpleValue>B</SimpleValue>
         </Value>
         <Value ColumnRef="navn">
            <SimpleValue>Maskinelt sat, ud fra GeoDanmark</SimpleValue>
         </Value>
         <Value ColumnRef="definition">
            <SimpleValue>sættes automatisk når vejnavnebeliggenheden er opdateret ud fra GeoDanmark</SimpleValue>
         </Value>
         <Value ColumnRef="kommentar">
            <SimpleValue>Nøjagtighedsklasse for Vejnavnebeliggenhed.</SimpleValue>
         </Value>
         <Value ColumnRef="virkningFra">
            <SimpleValue>2015-10-01</SimpleValue>
         </Value>
         <Value ColumnRef="virkningTil"/>
      </Row>
      <Row>
         <Value ColumnRef="kode">
            <SimpleValue>C</SimpleValue>
         </Value>
         <Value ColumnRef="navn">
            <SimpleValue>Manuelt sat, kommer til at følge GeoDanmark</SimpleValue>
         </Value>
         <Value ColumnRef="definition">
            <SimpleValue>manuelt placerede veje i DAR, der skal opdateres og følge GeoDanmark Vejmidter</SimpleValue>
         </Value>
         <Value ColumnRef="kommentar">
            <SimpleValue>Nøjagtighedsklasse for Vejnavnebeliggenhed.</SimpleValue>
         </Value>
         <Value ColumnRef="virkningFra">
            <SimpleValue>2015-10-01</SimpleValue>
         </Value>
         <Value ColumnRef="virkningTil"/>
      </Row>
      <Row>
         <Value ColumnRef="kode">
            <SimpleValue>U</SimpleValue>
         </Value>
         <Value ColumnRef="navn">
            <SimpleValue>Adressepunkt uden koordinater - stedfæstelse ukendt</SimpleValue>
         </Value>
         <Value ColumnRef="definition">
            <SimpleValue>adressepunktet er ikke stedfæstet med koordinater</SimpleValue>
         </Value>
         <Value ColumnRef="kommentar">
            <SimpleValue>Kan forekomme for historiske Adressepunkter (adgangspunkter).</SimpleValue>
         </Value>
         <Value ColumnRef="virkningFra">
            <SimpleValue>2015-10-01</SimpleValue>
         </Value>
         <Value ColumnRef="virkningTil"/>
      </Row>
   </SimpleCodeList>
