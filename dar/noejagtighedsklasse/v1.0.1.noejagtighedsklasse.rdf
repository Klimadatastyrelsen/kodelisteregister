   <skos:ConceptScheme rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/dar/noejagtighedsklasse">
      <dcterms:title xml:lang="da">noejagtighedsklasse</dcterms:title>
      <dcterms:identifier>urn:uuid:be8105b4-2903-4e7a-8ff5-be21be236acc</dcterms:identifier>
      <owl:sameAs rdf:resource="urn:uuid:be8105b4-2903-4e7a-8ff5-be21be236acc"/>
      <dcterms:creator xml:lang="da">Klimadatastyrelsen</dcterms:creator>
      <dcterms:description xml:lang="da">Kodelisten indeholder mulige værdier for nøjagtighedsklasse til DAR.</dcterms:description>
      <dcterms:provenance xml:lang="da">Kodelisten er opdateret med definitioner og evt. kommentarer.</dcterms:provenance>
      <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/deed.da"/>
