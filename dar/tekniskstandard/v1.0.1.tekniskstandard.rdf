      <skos:definition xml:lang="da">vejnavnebeliggenhed omskriver adresser, GeoDanmark vejmidter eller er konstrueret </skos:definition>
      <rdfs:comment xml:lang="da">Kan forekomme for historiske Navngivenvej.</rdfs:comment>
      <dcterms:valid>2015-10-01/..</dcterms:valid>
   </skos:Concept>
