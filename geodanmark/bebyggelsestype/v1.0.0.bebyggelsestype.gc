   <SimpleCodeList>
      <Row>
         <Value ColumnRef="kode">
            <SimpleValue>Lav bebyggelse</SimpleValue>
         </Value>
         <Value ColumnRef="navn">
            <SimpleValue>Lav bebyggelse</SimpleValue>
         </Value>
         <Value ColumnRef="definition">
            <SimpleValue>områder fortrinsvist bebygget med 1 og 2 etagers bygninger</SimpleValue>
         </Value>
         <Value ColumnRef="kommentar">
            <SimpleValue>hvor der ligger fritliggende bygning, eksempelvis rækkehus, parcelhus, serviceerhverv, skole samt gård på landet, inkluderes dette i LavBebyggelse. Disse områder kan udover bygninger eksempelvis også indeholde legeplads, have, græsplæne, bevoksning, fællesareal og parkeringsplads samt tank, silo, mødding og område til landbrugsredskaber, hvis arealet er af permanent karakter. Desuden også haveanlæg og park i forbindelse med slot eller herregård. LavBebyggelse optræder kun med et areal ≥ 2.500 m2 indenfor områdepolygon og udenfor områdepolygon kun med et areal &gt;500 m2</SimpleValue>
         </Value>
         <Value ColumnRef="virkningFra">
            <SimpleValue>2027-02-01</SimpleValue>
         </Value>
         <Value ColumnRef="virkningTil"/>
      </Row>
      <Row>
         <Value ColumnRef="kode">
            <SimpleValue>Høj bebyggelse</SimpleValue>
         </Value>
         <Value ColumnRef="navn">
            <SimpleValue>Høj bebyggelse</SimpleValue>
         </Value>
         <Value ColumnRef="definition">
            <SimpleValue>områder fortrinsvist bebygget med bygninger på mere end to etager, eksempelvis boligblok, karré, serviceerhverv, skole eller institution</SimpleValue>
         </Value>
         <Value ColumnRef="kommentar">
            <SimpleValue>området indeholder også legeplads, have, græsplæne, bevoksning, fællesareal, parkeringsplads og baggård. HøjBebyggelse optræder kun med et areal ≥ 2.500 m2</SimpleValue>
         </Value>
         <Value ColumnRef="virkningFra">
            <SimpleValue>2027-02-01</SimpleValue>
         </Value>
         <Value ColumnRef="virkningTil"/>
      </Row>
      <Row>
         <Value ColumnRef="kode">
            <SimpleValue>Erhverv</SimpleValue>
         </Value>
         <Value ColumnRef="navn">
            <SimpleValue>Erhverv</SimpleValue>
         </Value>
         <Value ColumnRef="definition">
            <SimpleValue>områder fortrinsvist bebygget med fabrikker, håndværks ejendomme, indkøbscentre og industrihavneområder</SimpleValue>
         </Value>
         <Value ColumnRef="kommentar">
            <SimpleValue>området indeholder alle de bygninger, tekniske anlæg, lagerpladser, græsarealer, parkeringsarealer og lignende områder, der umiddelbart hører med til Erhverv. Erhverv optræder kun med et areal ≥ 2.500 m2</SimpleValue>
         </Value>
         <Value ColumnRef="virkningFra">
            <SimpleValue>2027-02-01</SimpleValue>
         </Value>
         <Value ColumnRef="virkningTil"/>
      </Row>
      <Row>
         <Value ColumnRef="kode">
            <SimpleValue>Trafikområde</SimpleValue>
         </Value>
         <Value ColumnRef="navn">
            <SimpleValue>Trafikområde</SimpleValue>
         </Value>
         <Value ColumnRef="definition">
            <SimpleValue>arealer i byer bestående af veje, stier, jernbane og letbane som er så brede, at de ikke vil være egnede til at repræsentere andre bebyggelsestyper</SimpleValue>
         </Value>
         <Value ColumnRef="kommentar">
            <SimpleValue>trafikområder optræder kun med et areal ≥ 2.500 m2</SimpleValue>
         </Value>
         <Value ColumnRef="virkningFra">
            <SimpleValue>2027-02-01</SimpleValue>
         </Value>
         <Value ColumnRef="virkningTil"/>
      </Row>
   </SimpleCodeList>
</gc:CodeList>