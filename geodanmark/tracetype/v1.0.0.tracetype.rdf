   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/tracetype/Vej i delt tracé">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/tracetype"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/tracetype"/>
      <skos:notation>Vej i delt tracé</skos:notation>
      <skos:prefLabel xml:lang="da">Vej i delt tracé</skos:prefLabel>
      <skos:definition xml:lang="da">vej med dobbeltrettet færdsel, hvor kørebanerne er samlet uden fysisk adskillelse (som f.eks. midterrabat) mellem retningerne</skos:definition>
      <rdfs:comment xml:lang="da">dækker over almindelige veje, hvor modkørende trafik deler det samme færdselsareal, og vejen derfor registreres med én fælles midtlinje</rdfs:comment>
      <dcterms:valid>2027-02-01/..</dcterms:valid>
   </skos:Concept>
   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/tracetype/Vej i eget tracé">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/tracetype"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/tracetype"/>
      <skos:notation>Vej i eget tracé</skos:notation>
      <skos:prefLabel xml:lang="da">Vej i eget tracé</skos:prefLabel>
      <skos:definition xml:lang="da">veje med ensrettet færdsel, der har deres eget selvstændige forløb. F.eks. til- og frakørselsramper, ensrettede gader i byer</skos:definition>
      <dcterms:valid>2027-02-01/..</dcterms:valid>
   </skos:Concept>
   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/tracetype/Vej i parallelt tracé">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/tracetype"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/tracetype"/>
      <skos:notation>Vej i parallelt tracé</skos:notation>
      <skos:prefLabel xml:lang="da">Vej i parallelt tracé</skos:prefLabel>
      <skos:definition xml:lang="da">veje med ensrettet færdsel og parallelle forløb, hvor kørebanerne er fysisk adskilt af f.eks. midterhelle, midterrabat eller autoværn</skos:definition>
      <rdfs:comment xml:lang="da">anvendes ved motorveje, motortrafikveje, kanaliseringsanlæg samt boulevarder</rdfs:comment>
      <dcterms:valid>2027-02-01/..</dcterms:valid>
   </skos:Concept>
   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/tracetype/Sti i eget tracé">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/tracetype"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/tracetype"/>
      <skos:notation>Sti i eget tracé</skos:notation>
      <skos:prefLabel xml:lang="da">Sti i eget tracé</skos:prefLabel>
      <skos:definition xml:lang="da">fritliggende sti med eget selvstændigt forløb, som ikke følger en vej. F.eks. stier gennem en skov, en sti gennem en park eller en sti mellem to boligområder i åbent landskab</skos:definition>
      <dcterms:valid>2027-02-01/..</dcterms:valid>
   </skos:Concept>
   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/tracetype/Sti langs vej">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/tracetype"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/tracetype"/>
      <skos:notation>Sti langs vej</skos:notation>
      <skos:prefLabel xml:lang="da">Sti langs vej</skos:prefLabel>
      <skos:definition xml:lang="da">stier, der løber langs en vej og følger dennes forløb (tracé). Kan være adskilt af kantsten, rabat eller lignende, og kan anvendes på både stier og baner</skos:definition>
      <rdfs:comment xml:lang="da">har ofte samme vejkode som vejen den forløber langs</rdfs:comment>
      <dcterms:valid>2027-02-01/..</dcterms:valid>
   </skos:Concept>
   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/tracetype/Ikke tildelt">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/tracetype"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/tracetype"/>
      <skos:notation>Ikke tildelt</skos:notation>
      <skos:prefLabel xml:lang="da">Ikke tildelt</skos:prefLabel>
      <skos:definition xml:lang="da">tildelingen mangler</skos:definition>
      <dcterms:valid>2027-02-01/..</dcterms:valid>
   </skos:Concept>
   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/tracetype/Ukendt">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/tracetype"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/tracetype"/>
      <skos:notation>Ukendt</skos:notation>
      <skos:prefLabel xml:lang="da">Ukendt</skos:prefLabel>
      <skos:definition xml:lang="da">type kendes ikke</skos:definition>
      <dcterms:valid>2027-02-01/..</dcterms:valid>
   </skos:Concept>
</rdf:RDF>