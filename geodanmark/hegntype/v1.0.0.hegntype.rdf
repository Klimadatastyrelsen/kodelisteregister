   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/hegnstype/Levende">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/hegnstype"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/hegnstype"/>
      <skos:notation>Levende</skos:notation>
      <skos:prefLabel xml:lang="da">Levende</skos:prefLabel>
      <skos:definition xml:lang="da">alle former for afgrænsninger med en vis fysisk forhindring i form af levende vækster. Hæk, buske , tætstående træer på række, læbælte og lignende</skos:definition>
      <dcterms:valid>2027-02-01/..</dcterms:valid>
   </skos:Concept>
   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/hegnstype/Tråd">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/hegnstype"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/hegnstype"/>
      <skos:notation>Tråd</skos:notation>
      <skos:prefLabel xml:lang="da">Tråd</skos:prefLabel>
      <skos:definition xml:lang="da">permanent afgrænsning med stor fysisk forhindring i form af et flettet trådhegn</skos:definition>
      <dcterms:valid>2027-02-01/..</dcterms:valid>
   </skos:Concept>
   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/hegnstype/Andet">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/hegnstype"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/hegnstype"/>
      <skos:notation>Andet</skos:notation>
      <skos:prefLabel xml:lang="da">Andet</skos:prefLabel>
      <skos:definition xml:lang="da">øvrige former for afgrænsning f.eks. plankeværk eller mur</skos:definition>
      <dcterms:valid>2027-02-01/..</dcterms:valid>
   </skos:Concept>
