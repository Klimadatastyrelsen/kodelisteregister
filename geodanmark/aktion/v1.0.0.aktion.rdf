   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/aktion/Ny">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/aktion"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/aktion"/>
      <skos:notation>Ny</skos:notation>
      <skos:prefLabel xml:lang="da">Ny</skos:prefLabel>
      <skos:definition xml:lang="da">der skal registreres et nyt objekt</skos:definition>
      <rdfs:comment xml:lang="da">anvendes kun de steder, hvor der ikke er en geometri for objektet i forvejen, men der kan godt være geometri for andre objekter. Ajourføringen udføres som ved totalajourføring. Den fotogrammetriske ajourføring skal selv finde og rette alle relevante forhold inden for området, uanset om der kun findes én udpegning inden for området</rdfs:comment>
      <dcterms:valid>2027-02-01/..</dcterms:valid>
   </skos:Concept>
   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/aktion/Slet">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/aktion"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/aktion"/>
      <skos:notation>Slet</skos:notation>
      <skos:prefLabel xml:lang="da">Slet</skos:prefLabel>
      <skos:definition xml:lang="da">objektet skal slettes</skos:definition>
      <rdfs:comment xml:lang="da">bruges for objekter, der findes i data, men ikke længere findes i naturen. Ajourføringen udføres som ved totalajourføring. Den fotogrammetriske ajourføring skal selv finde og rette alle relevante forhold inden for området, uanset om der kun findes én udpegning inden for området</rdfs:comment>
      <dcterms:valid>2027-02-01/..</dcterms:valid>
   </skos:Concept>
   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/aktion/Ændre geometri">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/aktion"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/aktion"/>
      <skos:notation>Ændre geometri</skos:notation>
      <skos:prefLabel xml:lang="da">Ændre geometri</skos:prefLabel>
      <skos:definition xml:lang="da">geometrien for objektet skal ændres</skos:definition>
      <rdfs:comment xml:lang="da">bruges for objekter, der findes i data, men har fået ændret deres geometriske forløb i naturen. Ajourføringen udføres som ved totalajourføring. Den fotogrammetriske ajourføring skal selv finde og rette alle relevante forhold inden for området, uanset om der kun findes én udpegning inden for området</rdfs:comment>
      <dcterms:valid>2027-02-01/..</dcterms:valid>
   </skos:Concept>
   <skos:Concept rdf:about="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/aktion/Ikke tildelt">
      <skos:inScheme rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/aktion"/>
      <skos:topConceptOf rdf:resource="https://klimadatastyrelsen.github.io/kodelisteregister/geodanmark/aktion"/>
      <skos:notation>Ikke tildelt</skos:notation>
      <skos:prefLabel xml:lang="da">Ikke tildelt</skos:prefLabel>
      <skos:definition xml:lang="da">defaultværdien. Der er ikke fastlagt, hvad der skal ske</skos:definition>
      <rdfs:comment xml:lang="da">denne værdi er standardværdien, når ingen af de andre mere detaljerede angivelser bruges. Typen af ændring er ikke specificeret. Der kan kun ajourføres forhold, der kan ses i billederne. Ajourføringen udføres som ved totalajourføring. Den fotogrammetriske ajourføring skal selv finde og rette alle relevante forhold inden for området, uanset om der kun findes én udpegning inden for området</rdfs:comment>
      <dcterms:valid>2027-02-01/..</dcterms:valid>
   </skos:Concept>
</rdf:RDF>