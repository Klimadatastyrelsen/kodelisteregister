      <Agency>
         <LongName>GeoDanmark</LongName>
      </Agency>
   </Identification>
   <ColumnSet>
      <Column Id="kode"
              Use="required">
         <Annotation>
            <Description>
               <dcterms:description>tilladt værdi i data</dcterms:description>
            </Description>
         </Annotation>
         <ShortName>kode</ShortName>
         <Data Type="string"/>
      </Column>
      <Column Id="navn"
              Use="required">
         <Annotation>
            <Description>
               <dcterms:description>foretrukne term for koden</dcterms:description>
            </Description>
         </Annotation>
         <ShortName>navn</ShortName>
         <Data Type="string"
               Lang="da"/>
      </Column>
      <Column Id="definition"
              Use="optional">
         <Annotation>
            <Description>
               <dcterms:description>kort beskrivelse eller formel forklaring af kodens betydning</dcterms:description>
            </Description>
         </Annotation>
         <ShortName>definition</ShortName>
         <Data Type="string"
               Lang="da"/>
      </Column>
      <Column Id="kommentar"
              Use="optional">
         <Annotation>
            <Description>
               <dcterms:description>kommentar som hjælper til afklaring af forståelse af koden</dcterms:description>
            </Description>
         </Annotation>
         <ShortName>kommentar</ShortName>
         <Data Type="string"
               Lang="da"/>
      </Column>
      <Column Id="virkningFra"
              Use="required">
         <Annotation>
            <Description>
               <dcterms:description>tidspunkt for hvornår koden må tages i anvendelse for nye registreringer</dcterms:description>
            </Description>
         </Annotation>
         <ShortName>virkningFra</ShortName>
         <Data Type="date"/>
      </Column>
      <Column Id="virkningTil"
              Use="optional">
         <Annotation>
            <Description>
               <dcterms:description>tidspunkt for hvornår koden ikke længere må anvendes i nye registreringer. Koden kan eksistere i data, der er registreret før dette tidspunkt</dcterms:description>
            </Description>
         </Annotation>
         <ShortName>virkningTil</ShortName>
         <Data Type="date"/>
      </Column>
      <Key Id="key_code">
         <ShortName>key_code</ShortName>
         <ColumnRef Ref="kode"/>
      </Key>
      <Key Id="key_navn">
         <ShortName>key_navn</ShortName>
         <ColumnRef Ref="navn"/>
      </Key>
   </ColumnSet>
   <SimpleCodeList>
      <Row>
         <Value ColumnRef="kode">
            <SimpleValue>Tunnel</SimpleValue>
         </Value>
         <Value ColumnRef="navn">
            <SimpleValue>Tunnel</SimpleValue>
         </Value>
         <Value ColumnRef="definition">
            <SimpleValue>underføring under land, under hav- eller søbund og/eller vand. En tunnel muliggør en passage under terræn for kørende eller gående trafik eller for dyr. Tunnel har et indgangsparti i begge ender</SimpleValue>
         </Value>
         <Value ColumnRef="kommentar"/>
         <Value ColumnRef="virkningFra">
            <SimpleValue>2027-02-01</SimpleValue>
         </Value>
         <Value ColumnRef="virkningTil"/>
      </Row>
      <Row>
         <Value ColumnRef="kode">
            <SimpleValue>Bro</SimpleValue>
         </Value>
         <Value ColumnRef="navn">
            <SimpleValue>Bro</SimpleValue>
         </Value>
         <Value ColumnRef="definition">
            <SimpleValue>en overføring over land og/eller vand. Overføringen består af et brodække af f.eks. beton. Brodækket er selvbærende eller bæres af piller og/eller er ophængt i kabler</SimpleValue>
         </Value>
         <Value ColumnRef="kommentar"/>
         <Value ColumnRef="virkningFra">
            <SimpleValue>2027-02-01</SimpleValue>
         </Value>
         <Value ColumnRef="virkningTil"/>
      </Row>
      <Row>
         <Value ColumnRef="kode">
            <SimpleValue>Spang</SimpleValue>
         </Value>
         <Value ColumnRef="navn">
            <SimpleValue>Spang</SimpleValue>
         </Value>
         <Value ColumnRef="definition">
            <SimpleValue>simpel og smal overføring over et mindre vandløb eller anden lavning i terrænet f.eks. en grøft. Kun gående og tohjulet trafik kan passere.</SimpleValue>
         </Value>
         <Value ColumnRef="kommentar">
            <SimpleValue>smalle ”Spang” med en bredde &lt; 2 meter registreres som en enkelt linje ved skønnet midte. Brede ”Spang” med en bredde =&gt; 2 registreres ved kanten hele vejen rundt om spangen og dets ender snappes sammen</SimpleValue>
         </Value>
         <Value ColumnRef="virkningFra">
            <SimpleValue>2027-02-01</SimpleValue>
         </Value>
         <Value ColumnRef="virkningTil"/>
      </Row>
      <Row>
         <Value ColumnRef="kode">
            <SimpleValue>Højvandsmur</SimpleValue>
         </Value>
         <Value ColumnRef="navn">
            <SimpleValue>Højvandsmur</SimpleValue>
         </Value>
         <Value ColumnRef="definition">
            <SimpleValue>konstruktion bestående af betonvæg, stålspuns, plastspuns eller træspuns anlagt primært ved kyst i havneområder og byer, hvor højvandsmuren beskytter baglandet mod oversvømmelse fra hav ved højvande</SimpleValue>
         </Value>
         <Value ColumnRef="kommentar"/>
         <Value ColumnRef="virkningFra">
            <SimpleValue>2027-02-01</SimpleValue>
         </Value>
         <Value ColumnRef="virkningTil"/>
      </Row>
   </SimpleCodeList>
</gc:CodeList>